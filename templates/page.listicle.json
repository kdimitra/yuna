        "summary_hpMNBU": {
          "type": "summary",
          "settings": {
            "summary_text": "<p><strong>Summary:</strong> Stop settling for generic Shopify themes that look like everyone else's store. EcomElevate is the <strong>most powerful and customizable</strong> Shopify theme ever created for serious e-commerce brands. With 50+ conversion-optimized sections, built-in advertorial capabilities, and pixel-perfect design controls, it's the only theme you'll ever need. Keep reading to discover why top brands are calling it a \"game-changer\"!</p>",
            "summary_margin_top": 30,
            "summary_margin_bottom": 30
          }
        },

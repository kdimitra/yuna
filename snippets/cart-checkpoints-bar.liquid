{% liquid
  assign is_quantity = false
  if block.settings.goal_type == 'quantity'
    assign is_quantity = true
  endif

  if is_quantity
    assign goal_multiplier = 1.0
    assign goal_max_reference = items_count
    if product_page and product
      assign goal_max_reference = items_count | plus: 1
    endif
  else
    assign goal_multiplier = 100.00
    assign goal_max_reference = cart.items_subtotal_price
    if product_page and product
      assign goal_max_reference = cart.items_subtotal_price | plus: product.selected_or_first_available_variant.price
    endif
  endif
  
  if block.settings.enable_goal_1
    assign highest_goal = block.settings.goal_1_amount | times: goal_multiplier
  endif
  if block.settings.enable_goal_2
    assign highest_goal = block.settings.goal_2_amount | times: goal_multiplier
  endif
  if block.settings.enable_goal_3
    assign highest_goal = block.settings.goal_3_amount | times: goal_multiplier
  endif
    
  assign bar_progress = goal_max_reference | divided_by: highest_goal | times: 100.00
  assign all_goals_reached = false
  if bar_progress >= 100.00
    assign all_goals_reached = true
    assign bar_progress = 100
  endif

  assign next_goal_text = nil
  if block.settings.enable_goal_1
    assign goal_1_position = block.settings.goal_1_amount | divided_by: highest_goal | times: goal_multiplier | times: 100.00
    if goal_1_position > bar_progress and next_goal_text == nil
      assign next_goal_text = block.settings.goal_1_text
      assign next_goal = block.settings.goal_1_amount | times: goal_multiplier
    endif
  endif
  if block.settings.enable_goal_2
    assign goal_2_position = block.settings.goal_2_amount | divided_by: highest_goal | times: goal_multiplier | times: 100.00
    if goal_2_position > bar_progress and next_goal_text == nil
      assign next_goal_text = block.settings.goal_2_text
      assign next_goal = block.settings.goal_2_amount | times: goal_multiplier
    endif
  endif
  if block.settings.enable_goal_3
    assign goal_3_position = block.settings.goal_3_amount | divided_by: highest_goal | times: goal_multiplier | times: 100.00
    if goal_3_position > bar_progress and next_goal_text == nil
      assign next_goal_text = block.settings.goal_3_text
      assign next_goal = block.settings.goal_3_amount | times: goal_multiplier
    endif
  endif
%}

{% capture goal_difference_html %}
  {% if is_quantity %}
    {{ next_goal | minus: items_count | round }}
  {% else %}
    <span>{{ next_goal | minus: cart.items_subtotal_price | money_without_trailing_zeros }}</span>
  {% endif %}
{% endcapture %}

<div class="cart-progress cart-checkpoints{% if product_page %} cart-checkpoints--product{% endif %}"
     style="--mobile-text-size: {{ block.settings.labels_mobile_text_size | divided_by: 10.0 }}rem;
            --desktop-text-size: {{ block.settings.labels_desktop_text_size | divided_by: 10.0 }}rem;
            --margin-top: {{ block.settings.margin_top | divided_by: 10.0 }}rem;
            --margin-bottom: {{ block.settings.margin_bottom | divided_by: 10.0 }}rem;
            --text-font-size: {{ block.settings.text_font_size | default: 14 }}px;
            --text-max-width: {{ block.settings.text_max_width | default: 600 }}px;
            --text-color: {{ block.settings.text_color | default: '#000000' }};
            --text-font-weight: {{ block.settings.text_font_weight | default: 400 }};
            --text-margin-bottom: {{ block.settings.text_margin_bottom | default: 10 }}px;
            {% if block.settings.bar_gradient != blank %}
              --bar-background: {{ block.settings.bar_gradient }};
            {% else %}
              --bar-background: {{ block.settings.bar_color | default: '#000000' }};
            {% endif %}
            --icon-bg: {{ block.settings.icon_bg_color | default: '#FFFFFF' }};
            --icon-color: {{ block.settings.icon_color | default: '#000000' }};
            --icon-size: {{ block.settings.icon_size | default: 36 }}px;
            --icon-border-radius: {{ block.settings.icon_border_radius | default: 50 }}%;
            --icon-border-width: {{ block.settings.icon_border_width | default: 0 }}px;
            --icon-border-color: {{ block.settings.icon_border_color | default: '#000000' }};"
     {{ block.shopify_attributes }}>
  <p class="cart-progress__text">
    {% if all_goals_reached == false %}
      {{ block.settings.progress_message | replace: '[amount]', goal_difference_html | replace: '[next_goal]', next_goal_text }}
    {% else %}
      {{ block.settings.success_message }}
    {% endif %}
  </p>
  <div class="cart-progress__bar">
    <div class="cart-progress__bar__progress" style="width: {{ bar_progress }}%;">&nbsp</div>
    {% if block.settings.enable_goal_1 %}
      <div class="cart-progress__bar__badge cart-checkpoints__icon" style="--position:{{ goal_1_position }}%;">
        <span class="material-symbols-outlined{% if block.settings.goal_1_icon_filled %} filled{% endif %}">
          {{ block.settings.goal_1_icon | strip | downcase | replace: ' ', '_' }}
        </span>
        {% if block.settings.goal_1_label != blank %}
          <span class='cart-checkpoints__label custom-font-size'>
            {{ block.settings.goal_1_label }}
          </span>
        {% endif %}
      </div>
    {% endif %}
    {% if block.settings.enable_goal_2 %}
      <div class="cart-progress__bar__badge cart-checkpoints__icon" style="--position:{{ goal_2_position }}%;">
        <span class="material-symbols-outlined{% if block.settings.goal_2_icon_filled %} filled{% endif %}">
          {{ block.settings.goal_2_icon | strip | downcase | replace: ' ', '_' }}
        </span>
        {% if block.settings.goal_2_label != blank %}
          <span class='cart-checkpoints__label custom-font-size'>
            {{ block.settings.goal_2_label }}
          </span>
        {% endif %}
      </div>
    {% endif %}
    {% if block.settings.enable_goal_3 %}
      <div class="cart-progress__bar__badge cart-checkpoints__icon" style="--position:{{ goal_3_position }}%;">
        <span class="material-symbols-outlined{% if block.settings.goal_3_icon_filled %} filled{% endif %}">
          {{ block.settings.goal_3_icon | strip | downcase | replace: ' ', '_' }}
        </span>
        {% if block.settings.goal_3_label != blank %}
          <span class='cart-checkpoints__label custom-font-size'>
            {{ block.settings.goal_3_label }}
          </span>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

<style>
  .cart-checkpoints .cart-progress__text {
    font-size: var(--text-font-size, 14px);
    max-width: var(--text-max-width, 600px);
    color: var(--text-color, #000000);
    font-weight: var(--text-font-weight, 400);
    margin: 0 auto var(--text-margin-bottom, 10px);
    text-align: center;
  }

  .cart-checkpoints .cart-progress__bar__progress {
    background: var(--bar-background, #000000);
    background-size: 100% 100%;
    animation: none !important;
    transition: width 0.3s ease;
  }

  .cart-checkpoints .cart-progress__bar__badge {
    background: var(--icon-bg, #FFFFFF);
    border-radius: var(--icon-border-radius, 50%);
    width: var(--icon-size, 36px);
    height: var(--icon-size, 36px);
    display: flex;
    align-items: center;
    justify-content: center;
    border: var(--icon-border-width, 0px) solid var(--icon-border-color, #000000);
  }

  .cart-checkpoints .cart-progress__bar__badge .material-symbols-outlined {
    color: var(--icon-color, #000000);
    font-size: calc(var(--icon-size, 36px) * 0.6);
  }
</style>

{% unless product_page %}
  {%- comment -%} Free gift auto-add/remove — cart drawer only {%- endcomment -%}
  {%- liquid
    assign has_gifts = false
    if block.settings.enable_goal_1 and block.settings.goal_1_free_gift != blank
      assign has_gifts = true
    endif
    if block.settings.enable_goal_2 and block.settings.goal_2_free_gift != blank
      assign has_gifts = true
    endif
    if block.settings.enable_goal_3 and block.settings.goal_3_free_gift != blank
      assign has_gifts = true
    endif
  -%}

  {% if has_gifts %}
    <script type="application/json" class="checkpoints-gifts-config">
    {
      "goalType": {{ block.settings.goal_type | json }},
      "gifts": [
        {% if block.settings.enable_goal_1 and block.settings.goal_1_free_gift != blank %}
          {
            "variantId": {{ block.settings.goal_1_free_gift.selected_or_first_available_variant.id | json }},
            "handle": {{ block.settings.goal_1_free_gift.handle | json }},
            "goalAmount": {{ block.settings.goal_1_amount }}
          }
        {% endif %}
        {% if block.settings.enable_goal_1 and block.settings.goal_1_free_gift != blank and block.settings.enable_goal_2 and block.settings.goal_2_free_gift != blank %},{% endif %}
        {% if block.settings.enable_goal_2 and block.settings.goal_2_free_gift != blank %}
          {
            "variantId": {{ block.settings.goal_2_free_gift.selected_or_first_available_variant.id | json }},
            "handle": {{ block.settings.goal_2_free_gift.handle | json }},
            "goalAmount": {{ block.settings.goal_2_amount }}
          }
        {% endif %}
        {% if block.settings.enable_goal_2 and block.settings.goal_2_free_gift != blank and block.settings.enable_goal_3 and block.settings.goal_3_free_gift != blank %},{% elsif block.settings.enable_goal_1 and block.settings.goal_1_free_gift != blank and block.settings.enable_goal_3 and block.settings.goal_3_free_gift != blank %},{% endif %}
        {% if block.settings.enable_goal_3 and block.settings.goal_3_free_gift != blank %}
          {
            "variantId": {{ block.settings.goal_3_free_gift.selected_or_first_available_variant.id | json }},
            "handle": {{ block.settings.goal_3_free_gift.handle | json }},
            "goalAmount": {{ block.settings.goal_3_amount }}
          }
        {% endif %}
      ]
    }
    </script>

    <script>
    (function() {
      'use strict';
      if (window.Shopify && window.Shopify.designMode) return;

      var configEl = document.querySelector('.checkpoints-gifts-config');
      if (!configEl) return;

      var cfg;
      try { cfg = JSON.parse(configEl.textContent); } catch(e) { return; }

      var gifts = cfg.gifts || [];
      if (gifts.length === 0) return;

      var goalType = cfg.goalType;
      var isQuantity = goalType === 'quantity';
      var isProcessing = false;
      var debounceTimer = null;
      var DEBOUNCE_MS = 1500;

      /* Build a set of gift handles for quick lookup */
      var giftHandleSet = {};
      for (var g = 0; g < gifts.length; g++) {
        giftHandleSet[gifts[g].handle] = true;
      }

      /* --- Manual-removal tracking via sessionStorage --- */
      var DISMISSED_KEY = 'checkpoints_dismissed_gifts';

      function getDismissed() {
        try {
          return JSON.parse(sessionStorage.getItem(DISMISSED_KEY)) || {};
        } catch(e) { return {}; }
      }
      function setDismissed(obj) {
        try { sessionStorage.setItem(DISMISSED_KEY, JSON.stringify(obj)); } catch(e) {}
      }
      function dismissGift(handle) {
        var d = getDismissed(); d[handle] = true; setDismissed(d);
      }
      function undismissGift(handle) {
        var d = getDismissed(); delete d[handle]; setDismissed(d);
      }
      function isDismissed(handle) {
        return !!getDismissed()[handle];
      }

      /* Track previous cart state so we can detect manual removals */
      var prevGiftHandlesInCart = {};

      /* Debounced wrapper — waits for cart activity to settle before acting */
      function scheduleCheck() {
        if (debounceTimer) clearTimeout(debounceTimer);
        debounceTimer = setTimeout(checkAndManageGifts, DEBOUNCE_MS);
      }

      function checkAndManageGifts() {
        if (isProcessing) return;
        isProcessing = true;

        fetch('/cart.js')
          .then(function(r) { return r.json(); })
          .then(function(cart) {
            /* Exclude gift items from cart value so gifts don't count toward thresholds */
            var cartValue = 0;
            if (isQuantity) {
              for (var q = 0; q < cart.items.length; q++) {
                if (!giftHandleSet[cart.items[q].handle]) {
                  cartValue += cart.items[q].quantity;
                }
              }
            } else {
              cartValue = cart.items_subtotal_price;
            }
            var goalMultiplier = isQuantity ? 1 : 100;

            var currentGiftHandlesInCart = {};
            var toAdd = [];
            var toRemove = [];

            for (var i = 0; i < gifts.length; i++) {
              var gift = gifts[i];
              var threshold = gift.goalAmount * goalMultiplier;
              var goalMet = cartValue >= threshold;

              /* Check if ANY variant of this product is in cart (match by handle) */
              var inCart = false;
              for (var j = 0; j < cart.items.length; j++) {
                if (cart.items[j].handle === gift.handle) {
                  inCart = true;
                  break;
                }
              }

              if (inCart) {
                currentGiftHandlesInCart[gift.handle] = true;
              }

              if (!goalMet) {
                /* Goal no longer met — remove ALL matching items AND clear dismissed flag */
                undismissGift(gift.handle);
                for (var k = 0; k < cart.items.length; k++) {
                  if (cart.items[k].handle === gift.handle) {
                    toRemove.push(cart.items[k].key);
                  }
                }
              } else if (goalMet && !inCart) {
                /* Goal met, gift not in cart */
                if (prevGiftHandlesInCart[gift.handle]) {
                  /* Was previously in cart but now gone = customer removed it */
                  dismissGift(gift.handle);
                }
                if (!isDismissed(gift.handle)) {
                  toAdd.push(gift.variantId);
                }
              }
              /* goalMet && inCart — gift is where it should be, leave it alone */
            }

            prevGiftHandlesInCart = currentGiftHandlesInCart;

            if (toAdd.length === 0 && toRemove.length === 0) {
              isProcessing = false;
              return;
            }

            var ops = [];

            if (toAdd.length > 0) {
              var addItems = toAdd.map(function(vid) { return { id: vid, quantity: 1 }; });
              ops.push(
                fetch('/cart/add.js', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ items: addItems })
                })
              );
            }

            for (var r = 0; r < toRemove.length; r++) {
              ops.push(
                fetch('/cart/change.js', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ id: toRemove[r], quantity: 0 })
                })
              );
            }

            Promise.all(ops)
              .then(function() {
                return fetch('?section_id=cart-drawer');
              })
              .then(function(r) { return r.text(); })
              .then(function(html) {
                var parser = new DOMParser();
                var doc = parser.parseFromString(html, 'text/html');
                var newCartItems = doc.querySelector('cart-drawer-items');
                var currentCartItems = document.querySelector('cart-drawer-items');
                if (newCartItems && currentCartItems) {
                  currentCartItems.innerHTML = newCartItems.innerHTML;
                }
                document.dispatchEvent(new CustomEvent('cart:refresh'));
                isProcessing = false;
              })
              .catch(function() {
                isProcessing = false;
              });
          })
          .catch(function() {
            isProcessing = false;
          });
      }

      /* Use debounced version for cart events so variant swapper can finish */
      document.addEventListener('cart:updated', scheduleCheck);
      document.addEventListener('cart-update', scheduleCheck);
      document.addEventListener('cartQuantityUpdated', scheduleCheck);

      /* Initial check on page load */
      setTimeout(checkAndManageGifts, 1500);
    })();
    </script>
  {% endif %}
{% endunless %}

{% if product_page %}
<script type="application/json" class="checkpoints-config">
{
  "cartSubtotal": {{ cart.items_subtotal_price }},
  "cartQuantity": {{ items_count }},
  "goalType": {{ block.settings.goal_type | json }},
  "variantPrice": {{ product.selected_or_first_available_variant.price }},
  "progressMessage": {{ block.settings.progress_message | json }},
  "successMessage": {{ block.settings.success_message | json }},
  "moneyFormat": {{ shop.money_format | json }},
  "goals": [
    {% if block.settings.enable_goal_1 %}{ "amount": {{ block.settings.goal_1_amount }}, "text": {{ block.settings.goal_1_text | json }} }{% endif %}
    {% if block.settings.enable_goal_1 and block.settings.enable_goal_2 %},{% endif %}
    {% if block.settings.enable_goal_2 %}{ "amount": {{ block.settings.goal_2_amount }}, "text": {{ block.settings.goal_2_text | json }} }{% endif %}
    {% if block.settings.enable_goal_2 and block.settings.enable_goal_3 %},{% elsif block.settings.enable_goal_1 and block.settings.enable_goal_3 %},{% endif %}
    {% if block.settings.enable_goal_3 %}{ "amount": {{ block.settings.goal_3_amount }}, "text": {{ block.settings.goal_3_text | json }} }{% endif %}
  ],
  "variants": {{ product.variants | json }},
  "gifts": [
    {% if block.settings.enable_goal_1 and block.settings.goal_1_free_gift != blank %}
      {
        "variantId": {{ block.settings.goal_1_free_gift.selected_or_first_available_variant.id | json }},
        "handle": {{ block.settings.goal_1_free_gift.handle | json }},
        "goalAmount": {{ block.settings.goal_1_amount }}
      }
    {% endif %}
    {% if block.settings.enable_goal_1 and block.settings.goal_1_free_gift != blank and block.settings.enable_goal_2 and block.settings.goal_2_free_gift != blank %},{% endif %}
    {% if block.settings.enable_goal_2 and block.settings.goal_2_free_gift != blank %}
      {
        "variantId": {{ block.settings.goal_2_free_gift.selected_or_first_available_variant.id | json }},
        "handle": {{ block.settings.goal_2_free_gift.handle | json }},
        "goalAmount": {{ block.settings.goal_2_amount }}
      }
    {% endif %}
    {% if block.settings.enable_goal_2 and block.settings.goal_2_free_gift != blank and block.settings.enable_goal_3 and block.settings.goal_3_free_gift != blank %},{% elsif block.settings.enable_goal_1 and block.settings.goal_1_free_gift != blank and block.settings.enable_goal_3 and block.settings.goal_3_free_gift != blank %},{% endif %}
    {% if block.settings.enable_goal_3 and block.settings.goal_3_free_gift != blank %}
      {
        "variantId": {{ block.settings.goal_3_free_gift.selected_or_first_available_variant.id | json }},
        "handle": {{ block.settings.goal_3_free_gift.handle | json }},
        "goalAmount": {{ block.settings.goal_3_amount }}
      }
    {% endif %}
  ]
}
</script>
<script>
(function() {
  'use strict';
  const wrapper = document.querySelector('.cart-checkpoints--product');
  if (!wrapper) return;

  const configEl = wrapper.parentElement.querySelector('.checkpoints-config') ||
                   document.querySelector('.checkpoints-config');
  if (!configEl) return;

  let cfg;
  try { cfg = JSON.parse(configEl.textContent); } catch(e) { return; }

  let cartSubtotal = cfg.cartSubtotal || 0;
  let cartQuantity = cfg.cartQuantity || 0;
  const isQuantity = cfg.goalType === 'quantity';
  const moneyFormat = cfg.moneyFormat;
  const progressMsg = cfg.progressMessage;
  const successMsg = cfg.successMessage;
  const goals = cfg.goals || [];
  const variants = cfg.variants || [];

  if (goals.length === 0) return;

  const highestGoal = goals[goals.length - 1].amount;
  const goalMultiplier = isQuantity ? 1 : 100;

  let currentVariantPrice = cfg.variantPrice || 0;
  let currentQuantity = 1;
  let currentQbDiscount = 0;

  function formatMoney(cents) {
    if (window.PriceManager && window.PriceManager.formatMoney) {
      return window.PriceManager.formatMoney(cents);
    }
    var value = (cents / 100).toFixed(2);
    return moneyFormat
      .replace(/\{\{\s*amount_with_comma_separator\s*\}\}/, value.replace('.', ','))
      .replace(/\{\{\s*amount_no_decimals_with_comma_separator\s*\}\}/, value.replace(/\.00$/, '').replace('.', ','))
      .replace(/\{\{\s*amount_no_decimals\s*\}\}/, value.replace(/\.00$/, ''))
      .replace(/\{\{\s*amount\s*\}\}/, value);
  }

  function updateCheckpointsBar() {
    var productValue;
    if (isQuantity) {
      productValue = currentQuantity;
    } else {
      var discountMultiplier = (100 - currentQbDiscount) / 100;
      productValue = Math.round(currentVariantPrice * discountMultiplier) * currentQuantity;
    }

    var total = isQuantity ? cartQuantity + productValue : cartSubtotal + productValue;
    var highestGoalValue = highestGoal * goalMultiplier;
    var progress = (total / highestGoalValue) * 100;
    var allReached = progress >= 100;
    if (allReached) progress = 100;

    // Update progress bar width
    var bar = wrapper.querySelector('.cart-progress__bar__progress');
    if (bar) bar.style.width = progress + '%';

    // Find next unreached goal
    var nextGoalText = null;
    var nextGoalValue = 0;
    for (var g = 0; g < goals.length; g++) {
      var goalValue = goals[g].amount * goalMultiplier;
      if (total < goalValue && !nextGoalText) {
        nextGoalText = goals[g].text;
        nextGoalValue = goalValue;
      }
    }

    // Update progress text
    var textEl = wrapper.querySelector('.cart-progress__text');
    if (!textEl) return;

    if (allReached) {
      textEl.innerHTML = successMsg;
    } else if (nextGoalText) {
      var remaining = nextGoalValue - total;
      var amountHtml;
      if (isQuantity) {
        amountHtml = Math.max(0, Math.round(remaining)).toString();
      } else {
        amountHtml = '<span>' + formatMoney(Math.max(0, remaining)) + '</span>';
      }
      textEl.innerHTML = progressMsg
        .replace('[amount]', amountHtml)
        .replace('[next_goal]', nextGoalText)
        .replace('[next_goal_lowercase]', nextGoalText.toLowerCase());
    }
  }

  // QB option changes
  document.addEventListener('qb:state-changed', function(e) {
    if (e.detail.quantity) currentQuantity = e.detail.quantity;
    if (e.detail.qbDiscount !== undefined) currentQbDiscount = e.detail.qbDiscount;
    updateCheckpointsBar();
  });

  // Bundle changes (multi-variant QB)
  document.addEventListener('bundle:state-changed', function(e) {
    if (e.detail.quantity !== undefined) currentQuantity = e.detail.quantity;
    if (e.detail.finalPrice !== undefined) currentVariantPrice = e.detail.finalPrice;
    currentQbDiscount = 0; // bundle already has pricing baked in
    updateCheckpointsBar();
  });

  // Subscription changes
  document.addEventListener('subscription:state-changed', function() {
    updateCheckpointsBar();
  });

  // Variant changes
  function handleVariant(e) {
    var variantId = e.detail && e.detail.variant ? e.detail.variant.id :
                    (e.detail ? (e.detail.variantId || e.detail.id) : null);
    if (variantId) {
      for (var i = 0; i < variants.length; i++) {
        if (variants[i].id == variantId) {
          currentVariantPrice = variants[i].price;
          break;
        }
      }
      updateCheckpointsBar();
    }
  }
  document.addEventListener('variant-change', handleVariant);
  document.addEventListener('variant:change', handleVariant);

  // Also watch the hidden variant input for programmatic changes
  function setupVariantObserver() {
    var form = document.querySelector('form[action*="/cart/add"]');
    if (!form) return;
    var input = form.querySelector('input[name="id"]');
    if (!input) return;

    function onInputChange() {
      var vid = input.value;
      for (var i = 0; i < variants.length; i++) {
        if (variants[i].id == vid) {
          currentVariantPrice = variants[i].price;
          updateCheckpointsBar();
          break;
        }
      }
    }

    var obs = new MutationObserver(onInputChange);
    obs.observe(input, { attributes: true, attributeFilter: ['value'] });
    input.addEventListener('change', onInputChange);
  }

  // Deferred init: wait for form to be in DOM
  function init() {
    setupVariantObserver();

    // Read initial QB state if present
    var qbActive = document.querySelector('.qb-wrapper .qb-option.qb-active');
    if (qbActive) {
      currentQuantity = parseInt(qbActive.dataset.qty) || 1;
    }

    // Read initial quantity from form
    var qtyInput = document.querySelector('.product-form__quantity-input, input[name="quantity"]');
    if (qtyInput && !qbActive) {
      currentQuantity = parseInt(qtyInput.value) || 1;
    }

    updateCheckpointsBar();
  }

  /* ── Gift auto-add/remove (only if cart drawer checkpoints bar is NOT active) ── */
  var gifts = cfg.gifts || [];
  var cartDrawerActive = document.querySelector('.checkpoints-gifts-config');
  var shouldManageGifts = gifts.length > 0 && !cartDrawerActive;

  var giftHandleSet = {};
  for (var gi = 0; gi < gifts.length; gi++) {
    giftHandleSet[gifts[gi].handle] = true;
  }

  /* --- SessionStorage dismissal tracking (shared key with cart drawer) --- */
  var DISMISSED_KEY = 'checkpoints_dismissed_gifts';

  function getDismissed() {
    try {
      return JSON.parse(sessionStorage.getItem(DISMISSED_KEY)) || {};
    } catch(e) { return {}; }
  }
  function setDismissed(obj) {
    try { sessionStorage.setItem(DISMISSED_KEY, JSON.stringify(obj)); } catch(e) {}
  }
  function dismissGift(handle) {
    var d = getDismissed(); d[handle] = true; setDismissed(d);
  }
  function undismissGift(handle) {
    var d = getDismissed(); delete d[handle]; setDismissed(d);
  }
  function isDismissed(handle) {
    return !!getDismissed()[handle];
  }

  var prevGiftHandlesInCart = {};
  var giftProcessing = false;

  /**
   * Core gift logic — returns a Promise that resolves when add/remove ops finish.
   * Does NOT re-render the cart drawer (caller decides).
   */
  function manageGifts(cart) {
    var cartValue = 0;
    if (isQuantity) {
      for (var q = 0; q < cart.items.length; q++) {
        if (!giftHandleSet[cart.items[q].handle]) {
          cartValue += cart.items[q].quantity;
        }
      }
    } else {
      cartValue = cart.items_subtotal_price;
    }

    var currentGiftHandlesInCart = {};
    var toAdd = [];
    var toRemove = [];

    for (var i = 0; i < gifts.length; i++) {
      var gift = gifts[i];
      var threshold = gift.goalAmount * goalMultiplier;
      var goalMet = cartValue >= threshold;

      var inCart = false;
      for (var j = 0; j < cart.items.length; j++) {
        if (cart.items[j].handle === gift.handle) {
          inCart = true;
          break;
        }
      }

      if (inCart) {
        currentGiftHandlesInCart[gift.handle] = true;
      }

      if (!goalMet) {
        undismissGift(gift.handle);
        for (var k = 0; k < cart.items.length; k++) {
          if (cart.items[k].handle === gift.handle) {
            toRemove.push(cart.items[k].key);
          }
        }
      } else if (goalMet && !inCart) {
        if (prevGiftHandlesInCart[gift.handle]) {
          dismissGift(gift.handle);
        }
        if (!isDismissed(gift.handle)) {
          toAdd.push(gift.variantId);
        }
      }
    }

    prevGiftHandlesInCart = currentGiftHandlesInCart;

    if (toAdd.length === 0 && toRemove.length === 0) {
      return Promise.resolve();
    }

    var ops = [];

    if (toAdd.length > 0) {
      var addItems = toAdd.map(function(vid) { return { id: vid, quantity: 1 }; });
      ops.push(
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: addItems })
        })
      );
    }

    for (var r = 0; r < toRemove.length; r++) {
      ops.push(
        fetch('/cart/change.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: toRemove[r], quantity: 0 })
        })
      );
    }

    return Promise.all(ops);
  }

  /**
   * Global hook — buy-buttons calls this BEFORE opening the cart drawer
   * so gifts are already in the cart when the drawer renders.
   * Returns a Promise that resolves when done.
   */
  if (shouldManageGifts) {
    window.__addCheckpointGifts = function() {
      if (giftProcessing) return Promise.resolve();
      giftProcessing = true;
      return fetch('/cart.js')
        .then(function(r) { return r.json(); })
        .then(function(cart) {
          cartSubtotal = cart.items_subtotal_price;
          cartQuantity = cart.items.reduce(function(s, item) { return s + item.quantity; }, 0);
          updateCheckpointsBar();
          return manageGifts(cart);
        })
        .then(function() { giftProcessing = false; })
        .catch(function() { giftProcessing = false; });
    };
  }

  /**
   * Event-based fallback — for non-buy-button cart changes (e.g. cart page,
   * quantity edits in cart drawer). Re-renders cart drawer after gift changes.
   */
  function checkAndManageGiftsWithRerender(cart) {
    if (giftProcessing) return;
    giftProcessing = true;
    manageGifts(cart)
      .then(function() {
        return fetch('?sections=cart-drawer,cart-icon-bubble&t=' + Date.now());
      })
      .then(function(r) { return r.json(); })
      .then(function(sections) {
        if (sections && sections['cart-drawer']) {
          var parser = new DOMParser();
          var doc = parser.parseFromString(sections['cart-drawer'], 'text/html');
          var newItems = doc.querySelector('cart-drawer-items') || doc.querySelector('.cart-items, [id*="cart-items"], .drawer__inner');
          var curItems = document.querySelector('cart-drawer-items') || document.querySelector('.cart-items, [id*="cart-items"], .drawer__inner');
          if (newItems && curItems) curItems.innerHTML = newItems.innerHTML;
        }
        if (sections && sections['cart-icon-bubble']) {
          var bParser = new DOMParser();
          var bDoc = bParser.parseFromString(sections['cart-icon-bubble'], 'text/html');
          var newBubble = bDoc.querySelector('.cart-count-bubble');
          var curBubble = document.querySelector('#cart-icon-bubble');
          if (curBubble && newBubble) {
            var existing = curBubble.querySelector('.cart-count-bubble');
            if (existing) existing.innerHTML = newBubble.innerHTML;
            else curBubble.appendChild(newBubble.cloneNode(true));
          }
        }
        document.dispatchEvent(new CustomEvent('cart:refresh'));
        giftProcessing = false;
      })
      .catch(function() { giftProcessing = false; });
  }

  /* ── Live cart sync: update progress bar + gift check after cart changes ── */
  var cartSyncTimer = null;
  var CART_SYNC_DEBOUNCE = 1500;

  function onCartChanged() {
    clearTimeout(cartSyncTimer);
    cartSyncTimer = setTimeout(function() {
      fetch('/cart.js')
        .then(function(r) { return r.json(); })
        .then(function(cart) {
          cartSubtotal = cart.items_subtotal_price;
          cartQuantity = cart.items.reduce(function(s, item) { return s + item.quantity; }, 0);
          updateCheckpointsBar();

          if (shouldManageGifts) {
            checkAndManageGiftsWithRerender(cart);
          }
        })
        .catch(function() {});
    }, CART_SYNC_DEBOUNCE);
  }

  document.addEventListener('cart:updated', onCartChanged);
  document.addEventListener('cart-update', onCartChanged);
  document.addEventListener('cartQuantityUpdated', onCartChanged);

  /* ── Initial gift check on page load (cart may already meet threshold) ── */
  function initialGiftCheck() {
    if (!shouldManageGifts) return;
    setTimeout(function() {
      fetch('/cart.js')
        .then(function(r) { return r.json(); })
        .then(function(cart) {
          cartSubtotal = cart.items_subtotal_price;
          cartQuantity = cart.items.reduce(function(s, item) { return s + item.quantity; }, 0);
          updateCheckpointsBar();
          checkAndManageGiftsWithRerender(cart);
        })
        .catch(function() {});
    }, 1500);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      init();
      initialGiftCheck();
    });
  } else {
    requestAnimationFrame(function() {
      init();
      initialGiftCheck();
    });
  }
})();
</script>
{% endif %}

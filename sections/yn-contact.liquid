{%- assign ct_id = 'YnContact-' | append: section.id -%}
{%- liquid
  assign topics = section.settings.topics | newline_to_br | split: '<br />'
-%}
<section class="{% render 'yn-section-class', s: section %} yn-ct" id="yn-{{ section.id }}">
  <div class="yn-wrap yn-ct__grid">
    {%- form 'contact', id: ct_id, class: 'yn-ct__form yn-rv' -%}
      {%- if section.settings.form_heading != blank -%}<h2 class="yn-ct__h">{{ section.settings.form_heading }}</h2>{%- endif -%}
      {%- if form.posted_successfully? -%}
        <p class="yn-form-ok" tabindex="-1" autofocus role="status">{{ section.settings.success }}</p>
      {%- elsif form.errors -%}
        <div class="yn-form-err" role="alert" tabindex="-1" autofocus>
          <p>{{ 'templates.contact.form.error_heading' | t }}</p>
          <ul>{%- for field in form.errors -%}<li>{% if field == 'form' %}{{ form.errors.messages[field] }}{% else %}{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}{% endif %}</li>{%- endfor -%}</ul>
        </div>
      {%- endif -%}
      <div class="yn-ct__fields">
        <label class="yn-field">{{ section.settings.l_name }}
          <input class="yn-input" type="text" name="contact[{{ section.settings.l_name | escape }}]" autocomplete="name" required value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
        </label>
        <label class="yn-field">{{ section.settings.l_email }}
          <input class="yn-input" type="email" name="contact[email]" autocomplete="email" required spellcheck="false" autocapitalize="off" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"{% if form.errors contains 'email' %} aria-invalid="true"{% endif %}>
        </label>
        <label class="yn-field">{{ section.settings.l_phone }} <span class="yn-opt">{{ section.settings.l_optional }}</span>
          <input class="yn-input" type="tel" name="contact[{{ section.settings.l_phone | escape }}]" autocomplete="tel" pattern="[0-9\-\+\s]*" value="{{ form.phone }}">
        </label>
        <label class="yn-field">{{ section.settings.l_order }} <span class="yn-opt">{{ section.settings.l_optional }}</span>
          <input class="yn-input" type="text" name="contact[{{ section.settings.l_order | escape }}]" placeholder="#1001">
        </label>
        {%- if topics.size > 0 and section.settings.topics != blank -%}
          <label class="yn-field yn-field--full">{{ section.settings.l_topic }}
            <select class="yn-input yn-select" name="contact[{{ section.settings.l_topic | escape }}]" required>
              <option value="">{{ section.settings.topic_placeholder }}</option>
              {%- for t in topics -%}{%- assign t2 = t | strip -%}{%- if t2 != blank -%}<option>{{ t2 }}</option>{%- endif -%}{%- endfor -%}
            </select>
          </label>
        {%- endif -%}
        <label class="yn-field yn-field--full">{{ section.settings.l_message }}
          <textarea class="yn-input yn-textarea" name="contact[body]" rows="6" required placeholder="{{ section.settings.message_placeholder | escape }}">{{ form.body }}</textarea>
        </label>
        <div class="yn-field--full"><button class="yn-btn yn-btn--solid yn-btn--block" type="submit">{{ section.settings.button }}</button></div>
      </div>
    {%- endform -%}

    <div class="yn-ct__info">
      {%- for block in section.blocks -%}
        <div class="yn-ct__card yn-rv{% if block.settings.dark %} is-dark{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.title != blank -%}<h3>{{ block.settings.title }}</h3>{%- endif -%}
          <div class="yn-rte">{{ block.settings.text }}</div>
          {%- if block.settings.button_label != blank -%}{% render 'yn-button', label: block.settings.button_label, link: block.settings.button_link, style: block.settings.button_style %}{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "YUNA contact form",
  "settings": [
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Send us a message" },
    { "type": "text", "id": "l_name", "label": "Name label", "default": "Name" },
    { "type": "text", "id": "l_email", "label": "Email label", "default": "Email" },
    { "type": "text", "id": "l_phone", "label": "Phone label", "default": "Phone" },
    { "type": "text", "id": "l_order", "label": "Order number label", "default": "Order number" },
    { "type": "text", "id": "l_optional", "label": "Optional hint", "default": "(optional)" },
    { "type": "text", "id": "l_topic", "label": "Topic label", "default": "Topic" },
    { "type": "text", "id": "topic_placeholder", "label": "Topic placeholder", "default": "Choose a topic" },
    { "type": "textarea", "id": "topics", "label": "Topics (one per line)", "default": "My order\nProduct & ingredients\nWholesale & partnerships\nMedia & collaborations\nSomething else", "info": "Leave empty to hide the topic field." },
    { "type": "text", "id": "l_message", "label": "Message label", "default": "Message" },
    { "type": "text", "id": "message_placeholder", "label": "Message placeholder", "default": "How can we help?" },
    { "type": "text", "id": "button", "label": "Button label", "default": "Send message" },
    { "type": "text", "id": "success", "label": "Success message", "default": "Thank you! We’ve received your message and will reply by email soon." },
    { "type": "header", "content": "Section style" },
    { "type": "select", "id": "bg", "label": "Background", "options": [{ "value": "white", "label": "White" }, { "value": "cream", "label": "Cream" }, { "value": "beige", "label": "Beige" }], "default": "white" },
    { "type": "select", "id": "pt", "label": "Space above", "options": [{ "value": "none", "label": "None" }, { "value": "half", "label": "Half" }, { "value": "full", "label": "Full" }], "default": "none" },
    { "type": "select", "id": "pb", "label": "Space below", "options": [{ "value": "none", "label": "None" }, { "value": "half", "label": "Half" }, { "value": "full", "label": "Full" }], "default": "full" }
  ],
  "blocks": [
    { "type": "card", "name": "Info card", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Email us" },
      { "type": "richtext", "id": "text", "label": "Text", "default": "<p><a href=\"mailto:hello@yunasleep.com\">hello@yunasleep.com</a></p>" },
      { "type": "text", "id": "button_label", "label": "Button label" },
      { "type": "url", "id": "button_link", "label": "Button link" },
      { "type": "select", "id": "button_style", "label": "Button style", "options": [{ "value": "solid", "label": "Solid" }, { "value": "outline", "label": "Outline" }, { "value": "light", "label": "Light" }], "default": "light" },
      { "type": "checkbox", "id": "dark", "label": "Navy card", "default": false }
    ] }
  ],
  "presets": [{ "name": "YUNA contact form", "blocks": [{ "type": "card" }] }]
}
{% endschema %}

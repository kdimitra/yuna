<section class="{% render 'yn-section-class', s: section %} yn-stories yn-stories--{{ section.settings.layout }}" id="yn-{{ section.id }}">
  <div class="yn-wrap">
    <div class="yn-head yn-head--center yn-rv">
      {%- render 'yn-heading', heading: section.settings.heading, accent: section.settings.accent -%}
      {%- if section.settings.text != blank -%}<p class="yn-head__sub">{{ section.settings.text }}</p>{%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="yn-stories__list" data-yn-scroller>
        {%- for block in section.blocks -%}
          {%- liquid
            assign has_pair = false
            if block.settings.before != blank or block.settings.before_fallback != blank
              assign has_pair = true
            endif
          -%}
          <article class="yn-story yn-rv" {{ block.shopify_attributes }}>
            <div class="yn-story__ph{% if block.settings.dark %} is-dark{% endif %}{% if has_pair %} is-pair{% endif %}">
              {%- if has_pair -%}
                <figure>{% render 'yn-img', image: block.settings.before, fallback: block.settings.before_fallback, alt: block.settings.before_alt, sizes: '(max-width: 900px) 50vw, 220px', widths: '240, 360, 480' %}<span class="yn-story__lab">{{ block.settings.before_label }}</span></figure>
                <figure>{% render 'yn-img', image: block.settings.image, fallback: block.settings.fallback, alt: block.settings.alt, sizes: '(max-width: 900px) 50vw, 220px', widths: '240, 360, 480' %}<span class="yn-story__lab">{{ block.settings.after_label }}</span></figure>
              {%- else -%}
                {% render 'yn-img', image: block.settings.image, fallback: block.settings.fallback, alt: block.settings.alt, sizes: '(max-width: 900px) 100vw, 420px', widths: '360, 480, 720, 900' %}
              {%- endif -%}
              {%- if block.settings.tag != blank -%}<span class="yn-story__tag">{{ block.settings.tag }}</span>{%- endif -%}
            </div>
            <div class="yn-story__bd">
              {%- render 'yn-stars', rating: block.settings.rating, class: 'yn-story__stars' -%}
              {%- if block.settings.title != blank -%}<h3 class="yn-story__t">{{ block.settings.title }}</h3>{%- endif -%}
              {%- if block.settings.quote != blank -%}<p class="yn-story__q">{{ block.settings.quote }}</p>{%- endif -%}
              <p class="yn-story__nm"><b>{{ block.settings.name }}</b>{% if block.settings.verified %}{% render 'yn-icon', name: 'verified' %}<span>{{ section.settings.verified_label }}</span>{% endif %}</p>
            </div>
          </article>
        {%- endfor -%}
      </div>
      {%- if section.settings.layout == 'carousel' -%}
        <div class="yn-arrows yn-arrows--center">
          <button type="button" class="yn-arrow" aria-label="Previous stories" data-yn-prev>{% render 'yn-icon', name: 'arrow-left' %}</button>
          <button type="button" class="yn-arrow" aria-label="Next stories" data-yn-next>{% render 'yn-icon', name: 'arrow-right' %}</button>
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- if section.settings.note != blank -%}<p class="yn-note">{{ section.settings.note }}</p>{%- endif -%}
    {%- if section.settings.button_label != blank -%}<p class="yn-center yn-mt">{% render 'yn-button', label: section.settings.button_label, link: section.settings.button_link %}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "YUNA real results",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real results in weeks." },
    { "type": "text", "id": "accent", "label": "Heading accent", "default": "Refreshed mornings." },
    { "type": "textarea", "id": "text", "label": "Subheading", "default": "Real stories from women who made our beauty sleep supplement part of their nightly ritual." },
    { "type": "select", "id": "layout", "label": "Layout", "options": [{ "value": "grid", "label": "Grid (3 across)" }, { "value": "carousel", "label": "Carousel with arrows" }], "default": "grid" },
    { "type": "text", "id": "verified_label", "label": "Verified label", "default": "Verified customer" },
    { "type": "text", "id": "note", "label": "Note under cards", "default": "Individual results may vary." },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Section style" },
    { "type": "select", "id": "bg", "label": "Background", "options": [{ "value": "white", "label": "White" }, { "value": "cream", "label": "Cream" }, { "value": "beige", "label": "Beige" }, { "value": "navy", "label": "Navy" }], "default": "white" },
    { "type": "select", "id": "pt", "label": "Space above", "options": [{ "value": "none", "label": "None" }, { "value": "half", "label": "Half" }, { "value": "full", "label": "Full" }], "default": "full" },
    { "type": "select", "id": "pb", "label": "Space below", "options": [{ "value": "none", "label": "None" }, { "value": "half", "label": "Half" }, { "value": "full", "label": "Full" }], "default": "half" }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Story",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo (or After photo)" },
        { "type": "text", "id": "fallback", "label": "Default photo file (theme asset)" },
        { "type": "text", "id": "alt", "label": "Photo description" },
        { "type": "image_picker", "id": "before", "label": "Before photo (optional)", "info": "Add a before photo to show a side-by-side Before / After pair." },
        { "type": "text", "id": "before_fallback", "label": "Default before photo file (theme asset)" },
        { "type": "text", "id": "before_alt", "label": "Before photo description" },
        { "type": "text", "id": "before_label", "label": "Before label", "default": "Before" },
        { "type": "text", "id": "after_label", "label": "After label", "default": "After" },
        { "type": "checkbox", "id": "dark", "label": "Dark photo background", "default": false },
        { "type": "text", "id": "tag", "label": "Tag on photo", "default": "After 3 weeks" },
        { "type": "range", "id": "rating", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Title", "default": "“Woke up with a glow”" },
        { "type": "textarea", "id": "quote", "label": "Story" },
        { "type": "text", "id": "name", "label": "Name", "default": "Customer" },
        { "type": "checkbox", "id": "verified", "label": "Show verified badge", "default": true }
      ]
    }
  ],
  "presets": [{ "name": "YUNA real results", "blocks": [{ "type": "story" }, { "type": "story" }, { "type": "story" }] }]
}
{% endschema %}

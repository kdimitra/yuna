{%- liquid
  assign cats = section.blocks | where: 'type', 'category'
  assign title = section.settings.heading
  if title == blank
    assign title = page.title
  endif
-%}
<section class="yn yn-fqp" id="yn-{{ section.id }}" data-yn-faq>
  <div class="yn-fqp__hero yn-bg-{{ section.settings.bg }}">
    <div class="yn-wrap">
      <h1 class="yn-ph__title">{{ title }}{% if section.settings.accent != blank %} <em>{{ section.settings.accent }}</em>{% endif %}</h1>
      {%- if section.settings.text != blank -%}<div class="yn-fqp__intro">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.show_search -%}
        <label class="yn-fqp__search">
          {% render 'yn-icon', name: 'search' %}
          <span class="visually-hidden">{{ section.settings.search_label }}</span>
          <input type="search" placeholder="{{ section.settings.search_placeholder | escape }}" autocomplete="off" data-yn-faq-search aria-controls="YnFaqList-{{ section.id }}">
        </label>
        <p class="yn-fqp__count visually-hidden" role="status" aria-live="polite" data-yn-faq-status></p>
      {%- endif -%}
    </div>
  </div>

  <div class="yn-wrap yn-fqp__body yn-bg-{{ section.settings.bg }}">
    {%- if cats.size > 1 -%}
      <nav class="yn-fqp__tabs" aria-label="FAQ categories" data-yn-faq-tabs>
        {%- for c in cats -%}
          <a class="yn-fqp__tab{% if forloop.first %} is-on{% endif %}" href="#fq-{{ c.settings.anchor | default: c.settings.title | handleize }}" data-yn-faq-tab>{{ c.settings.title }}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}

    <div id="YnFaqList-{{ section.id }}" class="yn-fqp__list">
      {%- assign open_cat = false -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'category' -%}
          {%- if open_cat -%}</div></div>{%- endif -%}
          <div class="yn-fqp__cat" id="fq-{{ block.settings.anchor | default: block.settings.title | handleize }}" data-yn-faq-cat {{ block.shopify_attributes }}>
            <h2>{{ block.settings.title }}</h2>
            <div class="yn-fqp__qs">
          {%- assign open_cat = true -%}
        {%- else -%}
          {%- unless open_cat -%}<div class="yn-fqp__cat" data-yn-faq-cat><div class="yn-fqp__qs">{%- assign open_cat = true -%}{%- endunless -%}
          <details class="yn-q" data-yn-faq-q {{ block.shopify_attributes }}>
            <summary><span>{{ block.settings.question }}</span><i class="yn-pm" aria-hidden="true"></i></summary>
            <div class="yn-q__a yn-rte">{{ block.settings.answer }}</div>
          </details>
        {%- endif -%}
      {%- endfor -%}
      {%- if open_cat -%}</div></div>{%- endif -%}
      <p class="yn-fqp__none" hidden data-yn-faq-none>{{ section.settings.no_results }}</p>
    </div>
  </div>

  {%- assign qs = section.blocks | where: 'type', 'question' -%}
  {%- if qs.size > 0 -%}
    <script type="application/ld+json">
      {"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{%- for q in qs -%}{"@type":"Question","name":{{ q.settings.question | strip_html | json }},"acceptedAnswer":{"@type":"Answer","text":{{ q.settings.answer | strip_html | json }}}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]}
    </script>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "YUNA FAQ page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked", "info": "Leave empty to use the page title." },
    { "type": "text", "id": "accent", "label": "Heading accent", "default": "questions." },
    { "type": "richtext", "id": "text", "label": "Intro", "default": "<p>Everything from ingredients to delivery. Can’t find it? <a href=\"/pages/contact\">Contact us</a>.</p>" },
    { "type": "checkbox", "id": "show_search", "label": "Show search", "default": true },
    { "type": "text", "id": "search_label", "label": "Search label", "default": "Search FAQs" },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Search e.g. melatonin, delivery" },
    { "type": "richtext", "id": "no_results", "label": "No results message", "default": "<p>No questions match your search. <a href=\"/pages/contact\">Ask us directly</a>.</p>" },
    { "type": "select", "id": "bg", "label": "Background", "options": [{ "value": "white", "label": "White" }, { "value": "cream", "label": "Cream" }, { "value": "beige", "label": "Beige" }], "default": "white" }
  ],
  "blocks": [
    { "type": "category", "name": "Category", "settings": [
      { "type": "text", "id": "title", "label": "Category name", "default": "About YUNA" },
      { "type": "text", "id": "anchor", "label": "Anchor ID (optional)", "info": "Link to it with /pages/faq#fq-your-id" },
      { "type": "paragraph", "content": "Questions placed below this block belong to this category." }
    ] },
    { "type": "question", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "How do I take it?" },
      { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Take 2 capsules daily, 30–60 minutes before bed.</p>" }
    ] }
  ],
  "presets": [{ "name": "YUNA FAQ page", "blocks": [{ "type": "category" }, { "type": "question" }, { "type": "question" }] }]
}
{% endschema %}

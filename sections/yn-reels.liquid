<section class="{% render 'yn-section-class', s: section %} yn-reels" id="yn-{{ section.id }}" style="--mq-dur:{{ section.settings.speed }}s">
  <div class="yn-wrap">
    <div class="yn-head yn-head--split yn-rv">
      <div>
        {%- render 'yn-heading', heading: section.settings.heading, accent: section.settings.accent, size: 'm' -%}
        {%- if section.settings.text != blank -%}<p class="yn-head__sub">{{ section.settings.text }}</p>{%- endif -%}
        {%- if section.settings.rating != blank or section.settings.rating_text != blank -%}
          <p class="yn-rate-line">{% render 'yn-stars', rating: 5 %}{% if section.settings.rating != blank %}<b>{{ section.settings.rating }}</b>{% endif %}{% if section.settings.rating_text != blank %}<span aria-hidden="true">·</span>{{ section.settings.rating_text }}{% endif %}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
  <div class="yn-mrow yn-mrow--reels" data-yn-loop data-yn-reels>
    <div class="yn-mrow__track">
      {%- for block in section.blocks -%}
        {%- liquid
          assign vsrc = blank
          if block.type == 'video'
            if block.settings.video != blank
              assign vsrc = block.settings.video.sources | where: 'mime_type', 'video/mp4' | first
              assign vsrc = vsrc.url
            elsif block.settings.video_fallback != blank
              assign vsrc = block.settings.video_fallback | asset_url
            endif
          endif
          assign poster = blank
          if block.settings.image != blank
            assign poster = block.settings.image | image_url: width: 600
          elsif block.type == 'video' and block.settings.video != blank
            assign poster = block.settings.video.preview_image | image_url: width: 600
          elsif block.settings.fallback != blank
            assign poster = block.settings.fallback | asset_url
          endif
        -%}
        <figure class="yn-reel{% if block.type == 'photo' %} yn-reel--photo{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.type == 'video' and vsrc != blank -%}
            <video src="{{ vsrc }}"{% if poster != blank %} poster="{{ poster }}"{% endif %} muted loop playsinline preload="none" aria-label="{{ block.settings.name | escape }} video"></video>
            <button type="button" class="yn-reel__open" data-yn-reel-open="{{ vsrc }}" aria-label="Play {{ block.settings.name | escape }}’s video with sound"><span class="yn-reel__play">{% render 'yn-icon', name: 'play' %}</span></button>
          {%- else -%}
            {% render 'yn-img', image: block.settings.image, fallback: block.settings.fallback, alt: block.settings.alt, sizes: '280px', widths: '280, 420, 560', loading: 'eager' %}
          {%- endif -%}
          <figcaption class="yn-reel__q">
            {%- render 'yn-stars', rating: 5 -%}
            {%- if block.settings.quote != blank -%}<p>{{ block.settings.quote }}</p>{%- endif -%}
            <span>— {{ block.settings.name }}{% if section.settings.verified_label != blank %}<em>{{ section.settings.verified_label }}</em>{% endif %}</span>
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "YUNA customer videos",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why women are" },
    { "type": "text", "id": "accent", "label": "Heading accent", "default": "making it their ritual." },
    { "type": "text", "id": "text", "label": "Subheading", "default": "Busy women in Singapore, in their own words." },
    { "type": "text", "id": "rating", "label": "Rating", "default": "4.9" },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "10,000+ nightly rituals" },
    { "type": "text", "id": "verified_label", "label": "Verified label", "default": "Verified customer" },
    { "type": "range", "id": "speed", "label": "Loop duration (higher is slower)", "min": 10, "max": 90, "step": 2, "unit": "s", "default": 28 },
    { "type": "header", "content": "Section style" },
    { "type": "select", "id": "bg", "label": "Background", "options": [{ "value": "white", "label": "White" }, { "value": "cream", "label": "Cream" }, { "value": "beige", "label": "Beige" }, { "value": "navy", "label": "Navy" }], "default": "white" },
    { "type": "select", "id": "pt", "label": "Space above", "options": [{ "value": "none", "label": "None" }, { "value": "half", "label": "Half" }, { "value": "full", "label": "Full" }], "default": "half" },
    { "type": "select", "id": "pb", "label": "Space below", "options": [{ "value": "none", "label": "None" }, { "value": "half", "label": "Half" }, { "value": "full", "label": "Full" }], "default": "half" }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        { "type": "video", "id": "video", "label": "Video", "info": "Upload a vertical MP4 (9:16)." },
        { "type": "text", "id": "video_fallback", "label": "Default video file (theme asset)" },
        { "type": "image_picker", "id": "image", "label": "Poster image" },
        { "type": "text", "id": "fallback", "label": "Default poster file (theme asset)" },
        { "type": "text", "id": "quote", "label": "Quote", "default": "“Falling asleep is so much easier now.”" },
        { "type": "text", "id": "name", "label": "Name", "default": "Customer" }
      ]
    },
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "fallback", "label": "Default photo file (theme asset)" },
        { "type": "text", "id": "alt", "label": "Photo description" },
        { "type": "text", "id": "quote", "label": "Quote", "default": "“I wake up feeling properly rested.”" },
        { "type": "text", "id": "name", "label": "Name", "default": "Customer" }
      ]
    }
  ],
  "presets": [{ "name": "YUNA customer videos", "blocks": [{ "type": "video" }, { "type": "video" }, { "type": "photo" }] }]
}
{% endschema %}

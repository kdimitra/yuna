{{ 'yn-science.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<section class="yn yn-sci yn-sci-q{% if s.dividers %} yn-sci-q--lines{% endif %}" id="yn-{{ section.id }}"
  style="{% render 'yn-sci-vars', s: s %}--cols:{{ s.columns }};--cols-m:{{ s.columns_m }};--q-ic:{{ s.icon_size }}px;--q-ic-m:{{ s.icon_size_m }}px;--q-line:{{ s.divider_color }}">
  <div class="yn-wrap">
    {%- if s.heading != blank or s.accent != blank or s.text != blank -%}
      <div class="yn-sci__head yn-rv">
        {%- if s.heading != blank or s.accent != blank -%}
          <h2 class="yn-sci__h">{{ s.heading }}{% if s.accent != blank %} <em>{{ s.accent }}</em>{% endif %}</h2>
        {%- endif -%}
        {%- if s.text != blank -%}<div class="yn-sci__sub">{{ s.text }}</div>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="yn-sci-q__grid">
      {%- for block in section.blocks -%}
        <div class="yn-sci-q__item yn-rv" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank or block.settings.fallback != blank -%}
            {% render 'yn-img', image: block.settings.image, fallback: block.settings.fallback, alt: block.settings.title, sizes: '160px', widths: '160, 240, 320' %}
          {%- endif -%}
          {%- if block.settings.title != blank -%}<b>{{ block.settings.title }}</b>{%- endif -%}
          {%- if block.settings.text != blank -%}<span>{{ block.settings.text }}</span>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Science · Quality badges",
  "class": "yn-sci-section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Quality you" },
    { "type": "text", "id": "accent", "label": "Heading accent (second part)", "default": "can trust." },
    { "type": "richtext", "id": "text", "label": "Subheading", "default": "<p>Every batch of Daily Beauty Sleep™ is made to recognised standards and checked by an independent lab.</p>" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "columns", "label": "Columns, desktop", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "select", "id": "columns_m", "label": "Columns, mobile", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }], "default": "2" },
    { "type": "range", "id": "icon_size", "label": "Badge size, desktop", "min": 56, "max": 180, "step": 2, "unit": "px", "default": 108 },
    { "type": "range", "id": "icon_size_m", "label": "Badge size, mobile", "min": 48, "max": 140, "step": 2, "unit": "px", "default": 78 },
    { "type": "checkbox", "id": "dividers", "label": "Show divider lines between badges (desktop)", "default": true },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFFDFB" },
    { "type": "color", "id": "heading_color", "label": "Heading and badge titles", "default": "#161B30" },
    { "type": "color", "id": "accent_color", "label": "Heading accent", "default": "#161B30" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#575B6A" },
    { "type": "color", "id": "divider_color", "label": "Divider lines", "default": "#E3E4E6" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pt", "label": "Space above, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "pb", "label": "Space below, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "pt_m", "label": "Space above, mobile", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 22 },
    { "type": "range", "id": "pb_m", "label": "Space below, mobile", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 22 }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Badge image" },
        { "type": "text", "id": "fallback", "label": "Default image file (theme asset)" },
        { "type": "text", "id": "title", "label": "Title", "default": "ISO 9001 certified" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Quality management systems that keep every batch consistent." }
      ]
    }
  ],
  "presets": [{
    "name": "Science · Quality badges",
    "blocks": [
      { "type": "badge", "settings": { "fallback": "yn-cert-iso.png", "title": "ISO 9001 certified", "text": "Quality management systems that keep every batch consistent." } },
      { "type": "badge", "settings": { "fallback": "yn-cert-gmp.png", "title": "GMP certified", "text": "Made under Good Manufacturing Practice, in GMP and HACCP certified facilities." } },
      { "type": "badge", "settings": { "fallback": "yn-cert-lab.png", "title": "Third-party lab tested", "text": "Independently tested, so what’s on the label is what’s in the jar." } },
      { "type": "badge", "settings": { "fallback": "yn-cert-vegan.png", "title": "Vegan friendly", "text": "Plant-based herbs, mushrooms and probiotics. Melatonin-free." } }
    ]
  }]
}
{% endschema %}

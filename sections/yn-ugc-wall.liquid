<section class="{% render 'yn-section-class', s: section %} yn-ugc" id="yn-{{ section.id }}" style="--mq-dur:{{ section.settings.speed }}s">
  <div class="yn-wrap">
    <div class="yn-head yn-head--split yn-rv">
      <div>
        {%- render 'yn-heading', heading: section.settings.heading, accent: section.settings.accent, size: 'm' -%}
        {%- if section.settings.rating != blank or section.settings.rating_text != blank -%}
          <p class="yn-rate-line">{% render 'yn-stars', rating: 5 %}{% if section.settings.rating != blank %}<b>{{ section.settings.rating }}</b>{% endif %}{% if section.settings.rating_text != blank %}<span aria-hidden="true">·</span>{{ section.settings.rating_text }}{% endif %}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.button_label != blank -%}
        <a class="yn-pill-link" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}{% render 'yn-icon', name: 'arrow-right' %}</a>
      {%- endif -%}
    </div>
  </div>
  <div class="yn-ugc__wall">
    {%- for r in (1..2) -%}
      {%- assign row_key = r | append: '' -%}
      {%- capture row_items -%}
        {%- for block in section.blocks -%}
          {%- assign brow = block.settings.row | default: '1' | append: '' -%}
          {%- if brow == row_key -%}
              {%- capture ug_inner -%}
                {% render 'yn-img', image: block.settings.image, fallback: block.settings.fallback, alt: block.settings.alt, sizes: '(max-width: 900px) 44vw, 260px', widths: '200, 300, 400, 520', loading: 'eager' %}
                <span class="yn-ug__ov">
                  {%- render 'yn-stars', rating: 5 -%}
                  {%- if block.settings.quote != blank -%}<b>{{ block.settings.quote }}</b>{%- endif -%}
                  <span>{{ block.settings.name }}{% if block.settings.verified %}{% render 'yn-icon', name: 'verified' %}{% endif %}</span>
                </span>
              {%- endcapture -%}
              {%- if block.settings.link != blank -%}
                <a class="yn-ug" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ ug_inner }}</a>
              {%- else -%}
                <div class="yn-ug" {{ block.shopify_attributes }}>{{ ug_inner }}</div>
              {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- assign row_trim = row_items | strip -%}
      {%- if row_trim != blank -%}
        <div class="yn-mrow{% if r == 2 %} yn-mrow--rev{% endif %}" data-yn-loop>
          <div class="yn-mrow__track">{{ row_items }}</div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "YUNA customer photo wall",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by" },
    { "type": "text", "id": "accent", "label": "Heading accent", "default": "Singaporeans." },
    { "type": "text", "id": "rating", "label": "Rating", "default": "4.9" },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "10,000+ nightly rituals" },
    { "type": "text", "id": "button_label", "label": "Button label", "info": "Leave empty to hide (e.g. on the Happy Customers page itself)." },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "range", "id": "speed", "label": "Loop duration (higher is slower)", "min": 15, "max": 120, "step": 5, "unit": "s", "default": 40 },
    { "type": "header", "content": "Section style" },
    { "type": "select", "id": "bg", "label": "Background", "options": [{ "value": "white", "label": "White" }, { "value": "cream", "label": "Cream" }, { "value": "beige", "label": "Beige" }, { "value": "navy", "label": "Navy" }], "default": "white" },
    { "type": "select", "id": "pt", "label": "Space above", "options": [{ "value": "none", "label": "None" }, { "value": "half", "label": "Half" }, { "value": "full", "label": "Full" }], "default": "half" },
    { "type": "select", "id": "pb", "label": "Space below", "options": [{ "value": "none", "label": "None" }, { "value": "half", "label": "Half" }, { "value": "full", "label": "Full" }], "default": "half" }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Customer photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "fallback", "label": "Default photo file (theme asset)" },
        { "type": "text", "id": "alt", "label": "Photo description" },
        { "type": "text", "id": "quote", "label": "Quote", "default": "“My new nightly ritual.”" },
        { "type": "text", "id": "name", "label": "Name", "default": "Customer" },
        { "type": "checkbox", "id": "verified", "label": "Verified badge", "default": true },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "select", "id": "row", "label": "Row", "options": [{ "value": "1", "label": "Top row (slides left)" }, { "value": "2", "label": "Bottom row (slides right)" }], "default": "1" }
      ]
    }
  ],
  "presets": [{ "name": "YUNA customer photo wall", "blocks": [{ "type": "photo" }, { "type": "photo" }, { "type": "photo", "settings": { "row": "2" } }, { "type": "photo", "settings": { "row": "2" } }] }]
}
{% endschema %}

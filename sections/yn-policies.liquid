{%- liquid
  assign title = section.settings.heading | default: page.title
  assign s = section.settings
  assign tabs = false
  if s.layout == 'tabs'
    assign tabs = true
  endif
-%}
<section class="yn yn-pol yn-pol--{{ s.layout }} yn-pol--w-{{ s.width }}" id="yn-{{ section.id }}"{% if tabs %} data-yn-tabs{% endif %}
  style="--pol-bg:{{ s.bg_color }};--pol-h:{{ s.heading_color }};--pol-tx:{{ s.text_color }};--pol-link:{{ s.link_color }};--pol-line:{{ s.line_color }};--pol-pt:{{ s.pt_d }}px;--pol-pb:{{ s.pb_d }}px;--pol-pt-m:{{ s.pt_m }}px;--pol-pb-m:{{ s.pb_m }}px">
  <div class="yn-wrap yn-pol__in">
    {%- if title != blank -%}<h1 class="yn-pol__title">{{ title }}</h1>{%- endif -%}
    {%- if section.blocks.size > 1 and s.show_nav -%}
      <nav class="yn-pol__tabs"{% if tabs %} role="tablist"{% endif %} aria-label="{{ title | escape }}">
        {%- for block in section.blocks -%}
          {%- assign aid = block.settings.anchor | default: block.settings.title | handleize -%}
          {%- if tabs -%}
            <a class="yn-pol__tab{% if forloop.first %} is-on{% endif %}" role="tab" id="tab-{{ aid }}" href="#{{ aid }}" aria-controls="{{ aid }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" data-yn-tab>{{ block.settings.title }}</a>
          {%- else -%}
            <a class="yn-pol__link" href="#{{ aid }}">{{ block.settings.title }}</a>
          {%- endif -%}
        {%- endfor -%}
      </nav>
    {%- endif -%}
    {%- for block in section.blocks -%}
      {%- liquid
        assign aid = block.settings.anchor | default: block.settings.title | handleize
        assign body = blank
        assign body2 = blank
        case block.settings.source_2
          when 'shipping'
            assign body2 = shop.shipping_policy.body
          when 'refund'
            assign body2 = shop.refund_policy.body
          when 'privacy'
            assign body2 = shop.privacy_policy.body
          when 'terms'
            assign body2 = shop.terms_of_service.body
        endcase
        case block.settings.source
          when 'shipping'
            assign body = shop.shipping_policy.body
          when 'refund'
            assign body = shop.refund_policy.body
          when 'privacy'
            assign body = shop.privacy_policy.body
          when 'terms'
            assign body = shop.terms_of_service.body
          when 'contact'
            assign body = shop.contact_information.body
        endcase
      -%}
      <article class="yn-pol__panel yn-rte" id="{{ aid }}"{% if tabs %} role="tabpanel" aria-labelledby="tab-{{ aid }}" data-yn-panel{% unless forloop.first %} data-hidden{% endunless %}{% endif %} {{ block.shopify_attributes }}>
        <h2>{{ block.settings.title }}</h2>
        {%- if block.settings.content != blank -%}
          {%- if block.settings.always_show_text or body == blank and body2 == blank -%}{{ block.settings.content }}{%- endif -%}
        {%- endif -%}
        {%- if body != blank -%}{{ body }}{%- endif -%}
        {%- if body2 != blank -%}{{ body2 }}{%- endif -%}
        {%- if block.settings.content == blank and body == blank and body2 == blank -%}<p>Add the {{ block.settings.title }} text in Settings &gt; Policies, or write it in this block.</p>{%- endif -%}
      </article>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "YUNA policies",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Policies", "info": "Leave empty to use the page title." },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "layout", "label": "Layout", "options": [{ "value": "stacked", "label": "All policies on one page (design)" }, { "value": "tabs", "label": "Tabs, one policy at a time" }], "default": "stacked" },
    { "type": "checkbox", "id": "show_nav", "label": "Show links to each policy", "default": true },
    { "type": "select", "id": "width", "label": "Content width", "options": [{ "value": "full", "label": "Full page width (design)" }, { "value": "narrow", "label": "Narrow, centred" }], "default": "full" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "Headings", "default": "#161B30" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#575B6A" },
    { "type": "color", "id": "link_color", "label": "Policy links", "default": "#161B30" },
    { "type": "color", "id": "line_color", "label": "Line under the links", "default": "#E8E8EA" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pt_d", "label": "Space above, desktop", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 66 },
    { "type": "range", "id": "pb_d", "label": "Space below, desktop", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 48 },
    { "type": "range", "id": "pt_m", "label": "Space above, mobile", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 44 },
    { "type": "range", "id": "pb_m", "label": "Space below, mobile", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 20 }
  ],
  "blocks": [
    { "type": "policy", "name": "Policy", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Shipping & Refunds" },
      { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "shipping", "info": "Footer links like /pages/policies#shipping open this tab." },
      { "type": "select", "id": "source", "label": "Include Shopify policy", "options": [
        { "value": "none", "label": "None (only the text below)" },
        { "value": "shipping", "label": "Shipping policy" },
        { "value": "refund", "label": "Refund policy" },
        { "value": "privacy", "label": "Privacy policy" },
        { "value": "terms", "label": "Terms of service" },
        { "value": "contact", "label": "Contact information" }
      ], "default": "none", "info": "Adds the text from Settings > Policies below the text above. Choose None to show only your own text, as in the design." },
      { "type": "select", "id": "source_2", "label": "Also include", "options": [
        { "value": "none", "label": "Nothing else" },
        { "value": "shipping", "label": "Shipping policy" },
        { "value": "refund", "label": "Refund policy" },
        { "value": "privacy", "label": "Privacy policy" },
        { "value": "terms", "label": "Terms of service" }
      ], "default": "none" },
      { "type": "richtext", "id": "content", "label": "Text" },
      { "type": "checkbox", "id": "always_show_text", "label": "Show this text even when a Shopify policy is included", "default": true }
    ] }
  ],
  "presets": [{ "name": "YUNA policies", "blocks": [{ "type": "policy" }] }]
}
{% endschema %}

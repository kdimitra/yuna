{%- liquid
  assign cols = section.settings.columns | default: 4
  assign total = section.blocks.size
-%}
<section class="{% render 'yn-section-class', s: section %} yn-baw" id="yn-{{ section.id }}" style="--baw-cols:{{ cols }};--baw-dur:{{ section.settings.speed }}s">
  <div class="yn-wrap">
    <div class="yn-head yn-head--center yn-rv">
      {%- render 'yn-heading', heading: section.settings.heading, accent: section.settings.accent, size: 'm' -%}
      {%- if section.settings.text != blank -%}<p class="yn-head__sub">{{ section.settings.text }}</p>{%- endif -%}
    </div>
  </div>

  {%- if total > 0 -%}
    {%- comment -%}
      Pairs are dealt round-robin into the columns. Every column loops its own pairs twice so the
      vertical scroll is seamless; odd columns move up, even columns move down.
    {%- endcomment -%}
    <div class="yn-baw__grid" aria-label="{{ section.settings.label | escape }}" data-yn-baw>
      {%- for c in (1..cols) -%}
        {%- assign col_index = c | minus: 1 -%}
        {%- assign dir = c | modulo: 2 -%}
        <div class="yn-baw__col yn-baw__col--{% if dir == 1 %}up{% else %}dn{% endif %}{% if c > 2 %} yn-hide-m{% endif %}">
          <div class="yn-baw__track">
            {%- for pass in (1..2) -%}
              {%- for block in section.blocks -%}
                {%- assign bi = forloop.index0 | modulo: cols -%}
                {%- comment -%} On mobile only 2 columns show, so columns 1-2 also take the pairs of columns 3-4. {%- endcomment -%}
                {%- assign bi_m = forloop.index0 | modulo: 2 -%}
                {%- if bi == col_index or c <= 2 and bi_m == col_index and bi >= 2 -%}
                  {%- assign alt_b = block.settings.name | append: ' before' -%}
                  {%- assign alt_a = block.settings.name | append: ' after' -%}
                  <figure class="yn-baw__card{% if bi != col_index %} yn-show-m-only{% endif %}"{% if pass == 1 and bi == col_index %} {{ block.shopify_attributes }}{% else %} aria-hidden="true"{% endif %}>
                    <div class="yn-baw__p2">
                      {% render 'yn-img', image: block.settings.before, fallback: block.settings.before_fallback, alt: alt_b, sizes: '(max-width: 900px) 25vw, 180px', widths: '180, 260, 360', loading: 'eager' %}
                      {% render 'yn-img', image: block.settings.after, fallback: block.settings.after_fallback, alt: alt_a, sizes: '(max-width: 900px) 25vw, 180px', widths: '180, 260, 360', loading: 'eager' %}
                      <span class="yn-baw__l yn-baw__l--b">{{ section.settings.before_label }}</span>
                      <span class="yn-baw__l yn-baw__l--a">{{ section.settings.after_label }}</span>
                    </div>
                    {%- if block.settings.caption != blank -%}<figcaption>{{ block.settings.caption }}</figcaption>{%- endif -%}
                  </figure>
                {%- endif -%}
              {%- endfor -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
  {%- if section.settings.note != blank -%}<p class="yn-note">{{ section.settings.note }}</p>{%- endif -%}
</section>

{% schema %}
{
  "name": "YUNA before & after wall",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Before & after," },
    { "type": "text", "id": "accent", "label": "Heading accent", "default": "night after night." },
    { "type": "textarea", "id": "text", "label": "Subheading" },
    { "type": "text", "id": "label", "label": "Accessible label", "default": "Customer before and after photos" },
    { "type": "range", "id": "columns", "label": "Columns on desktop (mobile shows 2)", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "range", "id": "speed", "label": "Scroll duration (higher is slower)", "min": 20, "max": 160, "step": 5, "unit": "s", "default": 60 },
    { "type": "text", "id": "before_label", "label": "Before label", "default": "Before" },
    { "type": "text", "id": "after_label", "label": "After label", "default": "After" },
    { "type": "text", "id": "note", "label": "Note", "default": "Individual results may vary." },
    { "type": "header", "content": "Section style" },
    { "type": "select", "id": "bg", "label": "Background", "options": [{ "value": "white", "label": "White" }, { "value": "cream", "label": "Cream" }, { "value": "beige", "label": "Beige" }, { "value": "navy", "label": "Navy" }], "default": "white" },
    { "type": "select", "id": "pt", "label": "Space above", "options": [{ "value": "none", "label": "None" }, { "value": "half", "label": "Half" }, { "value": "full", "label": "Full" }], "default": "half" },
    { "type": "select", "id": "pb", "label": "Space below", "options": [{ "value": "none", "label": "None" }, { "value": "half", "label": "Half" }, { "value": "full", "label": "Full" }], "default": "half" }
  ],
  "blocks": [
    {
      "type": "pair",
      "name": "Before / after pair",
      "settings": [
        { "type": "text", "id": "name", "label": "Customer name (for image descriptions)", "default": "Customer" },
        { "type": "image_picker", "id": "before", "label": "Before photo (portrait 3:4)" },
        { "type": "text", "id": "before_fallback", "label": "Default before file (theme asset)" },
        { "type": "image_picker", "id": "after", "label": "After photo (portrait 3:4)" },
        { "type": "text", "id": "after_fallback", "label": "Default after file (theme asset)" },
        { "type": "text", "id": "caption", "label": "Caption (optional)", "info": "E.g. Day 1 / 3 weeks" }
      ]
    }
  ],
  "presets": [{ "name": "YUNA before & after wall", "blocks": [{ "type": "pair" }, { "type": "pair" }, { "type": "pair" }, { "type": "pair" }] }]
}
{% endschema %}

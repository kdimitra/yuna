<section class="{% render 'yn-section-class', s: section %} yn-tl{% if section.settings.mobile_after_next %} yn-swap-m{% endif %}" id="yn-{{ section.id }}">
  <div class="yn-wrap">
    <div class="yn-head yn-head--split yn-tl__head yn-rv">
      <div>
        {%- render 'yn-heading', heading: section.settings.heading, accent: section.settings.accent, size: 'm' -%}
        {%- if section.settings.text != blank -%}<p class="yn-head__sub">{{ section.settings.text }}</p>{%- endif -%}
      </div>
      {%- if section.settings.button_label != blank -%}
        <a class="yn-pill-link yn-hide-m" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}{% render 'yn-icon', name: 'arrow-right' %}</a>
      {%- endif -%}
    </div>
    <div class="yn-tl__body" data-yn-timeline>
      <div class="yn-tl__track" aria-hidden="true"><i class="yn-tl__fill"></i></div>
      <ol class="yn-tl__steps">
        {%- for block in section.blocks -%}
          <li class="yn-tl__step" {{ block.shopify_attributes }}>
            <span class="yn-tl__no" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <div class="yn-tl__bd">
              {%- if block.settings.time != blank -%}<span class="yn-tl__tm">{{ block.settings.time }}</span>{%- endif -%}
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
              {%- if block.settings.tag != blank -%}<div class="yn-tl__ft">{{ block.settings.tag }}</div>{%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ol>
    </div>
    {%- if section.settings.button_label != blank -%}
      <a class="yn-pill-link yn-show-m yn-tl__mcta" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}{% render 'yn-icon', name: 'arrow-right' %}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "YUNA night timeline",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your night," },
    { "type": "text", "id": "accent", "label": "Heading accent", "default": "step by step." },
    { "type": "textarea", "id": "text", "label": "Subheading" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Start your 90 nights" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "On the product page, use #offer to scroll to the bundle picker." },
    { "type": "checkbox", "id": "mobile_after_next", "label": "On mobile, show this section after the next one", "default": false, "info": "Desktop keeps the order of the sections list." },
    { "type": "header", "content": "Section style" },
    { "type": "select", "id": "bg", "label": "Background", "options": [{ "value": "white", "label": "White" }, { "value": "cream", "label": "Cream" }, { "value": "beige", "label": "Beige" }, { "value": "navy", "label": "Navy" }], "default": "white" },
    { "type": "select", "id": "pt", "label": "Space above", "options": [{ "value": "none", "label": "None" }, { "value": "half", "label": "Half" }, { "value": "full", "label": "Full" }], "default": "half" },
    { "type": "select", "id": "pb", "label": "Space below", "options": [{ "value": "none", "label": "None" }, { "value": "half", "label": "Half" }, { "value": "full", "label": "Full" }], "default": "half" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "time", "label": "Time label", "default": "The first hour" },
        { "type": "text", "id": "title", "label": "Title", "default": "Wind down" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "text", "id": "tag", "label": "Footer tag", "default": "Calm mind" }
      ]
    }
  ],
  "presets": [{ "name": "YUNA night timeline", "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }, { "type": "step" }] }]
}
{% endschema %}

<section class="{% render 'yn-section-class', s: section %} yn-faq yn-faq--icon-{{ section.settings.icon_style | default: 'plain' }}{% if section.settings.sticky_heading %} yn-faq--sticky{% endif %}" id="{{ section.settings.anchor | default: 'faq' }}"
  style="--fq-line:{{ section.settings.line_color | default: '#161B30' }};--fq-q:{{ section.settings.question_color | default: '#575B6A' }};--fq-icon:{{ section.settings.icon_color | default: '#161B30' }};--fq-a:{{ section.settings.answer_color | default: '#575B6A' }}">
  <div class="yn-wrap yn-faq__grid">
    <div class="yn-faq__h yn-rv">
      {%- render 'yn-heading', heading: section.settings.heading, accent: section.settings.accent, size: 'm' -%}
      {%- if section.settings.text != blank -%}<div class="yn-rte yn-faq__intro">{{ section.settings.text }}</div>{%- endif -%}
    </div>
    <div class="yn-faq__list yn-rv">
      {%- for block in section.blocks -%}
        <details class="yn-q" {{ block.shopify_attributes }}>
          <summary><span>{{ block.settings.question }}</span><i class="yn-pm" aria-hidden="true"></i></summary>
          <div class="yn-q__a yn-rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
  {%- if section.settings.schema_markup and section.blocks.size > 0 -%}
    <script type="application/ld+json">
      {"@context":"https://schema.org","@type":"FAQPage","mainEntity":[
        {%- for block in section.blocks -%}{"@type":"Question","name":{{ block.settings.question | strip_html | json }},"acceptedAnswer":{"@type":"Answer","text":{{ block.settings.answer | strip_html | json }}}}{% unless forloop.last %},{% endunless %}{%- endfor -%}
      ]}
    </script>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "YUNA FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked" },
    { "type": "text", "id": "accent", "label": "Heading accent", "default": "questions." },
    { "type": "richtext", "id": "text", "label": "Intro", "default": "<p>Can’t find your answer? <a href=\"/pages/contact\">Contact us</a>.</p>" },
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "faq" },
    { "type": "checkbox", "id": "schema_markup", "label": "Add FAQ structured data for search engines", "default": true },
    { "type": "checkbox", "id": "sticky_heading", "label": "Keep the heading in view while scrolling (desktop)", "default": false },
    { "type": "header", "content": "Questions" },
    { "type": "select", "id": "icon_style", "label": "Open / close icon", "options": [{ "value": "plain", "label": "Plain + and − (design)" }, { "value": "boxed", "label": "+ and − in a small box" }], "default": "plain" },
    { "type": "color", "id": "question_color", "label": "Question text", "default": "#575B6A" },
    { "type": "color", "id": "answer_color", "label": "Answer text", "default": "#575B6A" },
    { "type": "color", "id": "icon_color", "label": "Icon", "default": "#161B30" },
    { "type": "color", "id": "line_color", "label": "Divider lines", "default": "#161B30" },
    { "type": "header", "content": "Section style" },
    { "type": "select", "id": "bg", "label": "Background", "options": [{ "value": "white", "label": "White" }, { "value": "cream", "label": "Cream" }, { "value": "beige", "label": "Beige" }, { "value": "navy", "label": "Navy" }], "default": "white" },
    { "type": "select", "id": "pt", "label": "Space above", "options": [{ "value": "none", "label": "None" }, { "value": "half", "label": "Half" }, { "value": "full", "label": "Full" }], "default": "half" },
    { "type": "select", "id": "pb", "label": "Space below", "options": [{ "value": "none", "label": "None" }, { "value": "half", "label": "Half" }, { "value": "full", "label": "Full" }], "default": "full" }
  ],
  "blocks": [
    { "type": "question", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "How do I take it?" },
      { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Take 2 capsules daily, 30–60 minutes before bed.</p>" }
    ] }
  ],
  "presets": [{ "name": "YUNA FAQ", "blocks": [{ "type": "question" }, { "type": "question" }] }]
}
{% endschema %}

<section class="{% render 'yn-section-class', s: section %} yn-richtext yn-richtext--{{ section.settings.align }}" id="yn-{{ section.id }}">
  <div class="yn-wrap">
    <div class="yn-richtext__in yn-rv" style="--rt-max:{{ section.settings.max_width }}px">
      {%- render 'yn-heading', heading: section.settings.heading, accent: section.settings.accent, size: 'm' -%}
      {%- if section.settings.text != blank -%}<div class="yn-rte yn-richtext__body">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.show_page_content and page.content != blank -%}<div class="yn-rte yn-richtext__body">{{ page.content }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}<p class="yn-mt">{% render 'yn-button', label: section.settings.button_label, link: section.settings.button_link, style: section.settings.button_style %}</p>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "YUNA rich text",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why sleep shows" },
    { "type": "text", "id": "accent", "label": "Heading accent", "default": "on your skin." },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "show_page_content", "label": "Show the page’s own content", "default": false, "info": "Useful for generic pages: the text you write in Online Store > Pages appears here." },
    { "type": "select", "id": "align", "label": "Alignment", "options": [{ "value": "center", "label": "Centre" }, { "value": "left", "label": "Left" }], "default": "center" },
    { "type": "range", "id": "max_width", "label": "Max width", "min": 480, "max": 1200, "step": 20, "unit": "px", "default": 760 },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "button_style", "label": "Button style", "options": [{ "value": "solid", "label": "Solid" }, { "value": "outline", "label": "Outline" }], "default": "solid" },
    { "type": "header", "content": "Section style" },
    { "type": "select", "id": "bg", "label": "Background", "options": [{ "value": "white", "label": "White" }, { "value": "cream", "label": "Cream" }, { "value": "beige", "label": "Beige" }, { "value": "navy", "label": "Navy" }], "default": "white" },
    { "type": "select", "id": "pt", "label": "Space above", "options": [{ "value": "none", "label": "None" }, { "value": "half", "label": "Half" }, { "value": "full", "label": "Full" }], "default": "full" },
    { "type": "select", "id": "pb", "label": "Space below", "options": [{ "value": "none", "label": "None" }, { "value": "half", "label": "Half" }, { "value": "full", "label": "Full" }], "default": "half" }
  ],
  "presets": [{ "name": "YUNA rich text" }]
}
{% endschema %}

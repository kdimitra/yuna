{{ 'yn-science.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign ov = s.overlay_color | default: '#161B30'
  assign ov_r = ov | color_extract: 'red'
  assign ov_g = ov | color_extract: 'green'
  assign ov_b = ov | color_extract: 'blue'
  assign lead_alpha = s.text_opacity | divided_by: 100.0
  assign lead_color = s.text_color | color_modify: 'alpha', lead_alpha
  assign has_img = false
  if s.image != blank or s.fallback != blank
    assign has_img = true
  endif
-%}
<section class="yn yn-sci-hero yn-sci-hero--{{ s.align }}{% if s.m_position == 'bottom' %} yn-sci-hero--m-bottom{% endif %}" id="yn-{{ section.id }}" data-yn-parallax="0.2"
  style="--s-bg:{{ s.bg }};--s-h:{{ s.heading_color }};--s-acc:{{ s.accent_color }};--s-tx:{{ lead_color }};--ov:{{ ov_r }} {{ ov_g }} {{ ov_b }};--ov-k:{{ s.overlay | divided_by: 100.0 }};--hero-h:clamp(420px,38vw,{{ s.height_d }}px);--hero-h-m:min(184vw,{{ s.height_m }}px);--hero-w:{{ s.text_width }}px;--hero-fs:{{ s.heading_size }}px;--hero-pos:{{ s.focus_x }}% 50%;--hero-pos-m:{{ s.focus_x_m }}% {{ s.focus_y_m }}%;--hero-pt-m:{{ s.pt_m }}px;--hero-bg-m:{{ s.bg_m }}">
  {%- if has_img -%}
    <picture class="yn-sci-hero__media" data-yn-parallax-media>
      {%- if s.image_m != blank -%}
        <source media="(max-width: 900px)" srcset="{{ s.image_m | image_url: width: 750 }} 750w, {{ s.image_m | image_url: width: 1100 }} 1100w, {{ s.image_m | image_url: width: 1500 }} 1500w" sizes="100vw">
      {%- elsif s.fallback_m != blank -%}
        <source media="(max-width: 900px)" srcset="{{ s.fallback_m | asset_url }}">
      {%- endif -%}
      {% render 'yn-img', image: s.image, fallback: s.fallback, alt: s.alt, priority: true, sizes: '100vw' %}
    </picture>
  {%- endif -%}
  <div class="yn-sci-hero__in">
    <div class="yn-sci-hero__copy yn-rv is-in">
      {%- if s.heading != blank or s.accent != blank -%}
        <h1>{{ s.heading }}{% if s.accent != blank %} <em>{{ s.accent }}</em>{% endif %}</h1>
      {%- endif -%}
      {%- if s.text != blank -%}<div class="yn-sci-hero__lead">{{ s.text }}</div>{%- endif -%}
      {%- if s.button_label != blank -%}<div class="yn-sci-hero__btn">{% render 'yn-button', label: s.button_label, link: s.button_link, style: s.button_style %}</div>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Science · Hero",
  "class": "yn-sci-section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The science of" },
    { "type": "text", "id": "accent", "label": "Heading accent (second part)", "default": "beauty sleep." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Eight natural ingredients in one herbal sleep aid, each with a clear role, working together through the night so you rest deeper and wake up glowing.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "button_style", "label": "Button style", "options": [{ "value": "light", "label": "Light" }, { "value": "solid", "label": "Solid" }, { "value": "outline", "label": "Outline" }], "default": "light" },
    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "image", "label": "Desktop image", "info": "Wide image, about 2:1. Leave empty to use the default." },
    { "type": "text", "id": "fallback", "label": "Default desktop image file (theme asset)", "default": "yn-sci-hero-desk.webp" },
    { "type": "image_picker", "id": "image_m", "label": "Mobile image", "info": "Tall image, about 1:2." },
    { "type": "text", "id": "fallback_m", "label": "Default mobile image file (theme asset)", "default": "yn-sci-hero-mob.webp" },
    { "type": "text", "id": "alt", "label": "Image description" },
    { "type": "range", "id": "focus_x", "label": "Desktop image focus, left to right", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 65 },
    { "type": "range", "id": "focus_x_m", "label": "Mobile image focus, left to right", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50 },
    { "type": "range", "id": "focus_y_m", "label": "Mobile image focus, top to bottom", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 0 },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "align", "label": "Text alignment, desktop", "options": [{ "value": "left", "label": "Left (gradient from the left)" }, { "value": "center", "label": "Centre (even overlay)" }], "default": "left" },
    { "type": "range", "id": "text_width", "label": "Text width", "min": 400, "max": 900, "step": 20, "unit": "px", "default": 560 },
    { "type": "range", "id": "heading_size", "label": "Heading size, desktop", "min": 40, "max": 80, "step": 1, "unit": "px", "default": 63 },
    { "type": "range", "id": "height_d", "label": "Height, desktop (max)", "min": 420, "max": 900, "step": 10, "unit": "px", "default": 600 },
    { "type": "range", "id": "height_m", "label": "Height, mobile (max)", "min": 480, "max": 900, "step": 10, "unit": "px", "default": 740 },
    { "type": "select", "id": "m_position", "label": "Text position, mobile", "options": [{ "value": "top", "label": "Top" }, { "value": "bottom", "label": "Bottom" }], "default": "top" },
    { "type": "range", "id": "pt_m", "label": "Space above text, mobile", "min": 40, "max": 300, "step": 10, "unit": "px", "default": 150 },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_color", "label": "Heading accent", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" },
    { "type": "range", "id": "text_opacity", "label": "Text opacity", "min": 50, "max": 100, "step": 2, "unit": "%", "default": 88 },
    { "type": "color", "id": "overlay_color", "label": "Overlay", "default": "#161B30" },
    { "type": "range", "id": "overlay", "label": "Overlay strength", "min": 0, "max": 120, "step": 5, "unit": "%", "default": 100, "info": "100% matches the design: dark on the text side, fading out over the photo." },
    { "type": "color", "id": "bg", "label": "Background behind the image, desktop", "default": "#161B30" },
    { "type": "color", "id": "bg_m", "label": "Background behind the image, mobile", "default": "#3A332C" }
  ],
  "presets": [{ "name": "Science · Hero" }]
}
{% endschema %}

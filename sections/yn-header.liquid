{%- liquid
  assign main_menu = section.settings.menu
  assign mobile_menu = section.settings.mobile_menu | default: section.settings.menu
  assign promo_product = section.settings.promo_product
  assign logo_alt = section.settings.logo.alt | default: shop.name
-%}
{%- capture logo_html -%}
  {%- if section.settings.logo != blank -%}
    {{ section.settings.logo | image_url: width: 600 | image_tag: class: 'yn-logo__img', alt: logo_alt, widths: '200, 300, 400, 600', sizes: '200px' }}
  {%- elsif section.settings.logo_fallback != blank -%}
    <img class="yn-logo__img" src="{{ section.settings.logo_fallback | asset_url }}" alt="{{ shop.name | escape }}" width="1062" height="278">
  {%- else -%}
    <span class="yn-logo__text">{{ shop.name }}</span>
  {%- endif -%}
{%- endcapture -%}

<header class="yn yn-hdr{% if section.settings.floating %} yn-hdr--float{% endif %}{% if section.settings.sticky %} yn-hdr--sticky{% endif %} yn-hdr--{{ section.settings.layout }}" data-yn-header style="--hdr-bg:{{ section.settings.bg }};--hdr-line:{% if section.settings.show_line %}{{ section.settings.line_color }}{% else %}transparent{% endif %};--logo-w:{{ section.settings.logo_width }}px;--logo-w-m:{{ section.settings.logo_width_mobile }}px">
  <div class="yn-hdr__bar">
    <button type="button" class="yn-iconbtn yn-hdr__burger" aria-label="Open menu" aria-controls="YnMobileNav" aria-expanded="false" data-yn-nav-open>{% render 'yn-icon', name: 'menu' %}</button>

    {%- if request.page_type == 'index' -%}<h1 class="yn-hdr__logo-wrap">{%- endif -%}
    <a class="yn-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">{{ logo_html }}</a>
    {%- if request.page_type == 'index' -%}</h1>{%- endif -%}

    <nav class="yn-hdr__nav" aria-label="Main">
      {%- for link in main_menu.links -%}
        {%- if link.links.size > 0 -%}
          <details class="yn-hdr__dd">
            <summary class="yn-hdr__link{% if link.child_active or link.active %} is-active{% endif %}">{{ link.title }}</summary>
            <div class="yn-hdr__ddpanel">
              {%- for child in link.links -%}<a href="{{ child.url }}"{% if child.active %} aria-current="page"{% endif %}>{{ child.title }}</a>{%- endfor -%}
            </div>
          </details>
        {%- else -%}
          <a class="yn-hdr__link{% if link.active or link.child_active %} is-active{% endif %}" href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    <div class="yn-hdr__tools header__icons">
      {%- if section.settings.show_search -%}
        <a class="yn-iconbtn yn-hide-m" href="{{ routes.search_url }}" aria-label="Search">{% render 'yn-icon', name: 'search' %}</a>
      {%- endif -%}
      {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
        <a class="yn-iconbtn yn-hide-m" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" aria-label="{% if customer %}Account{% else %}Log in{% endif %}">{% render 'yn-icon', name: 'user' %}</a>
      {%- endif -%}
      {%- comment -%} The legacy cart drawer script reads a data attribute from a form inside .header__icons; without it the drawer fails to start. {%- endcomment -%}
      <form class="yn-legacy-hook" data-modal="" hidden aria-hidden="true"></form>
      <a href="{{ routes.cart_url }}" class="yn-iconbtn yn-hdr__cart" id="cart-icon-bubble" data-yn-cart-link>
        {%- render 'yn-cart-icon' -%}
      </a>
    </div>
  </div>
</header>

{%- comment -%} Mobile menu drawer {%- endcomment -%}
<div class="yn yn-mnav" id="YnMobileNav" aria-hidden="true" data-yn-nav>
  <div class="yn-mnav__scrim" data-yn-nav-close></div>
  <div class="yn-mnav__panel" role="dialog" aria-modal="true" aria-label="Menu" tabindex="-1">
    <div class="yn-mnav__top">
      <a class="yn-logo" href="{{ routes.root_url }}">{{ logo_html }}</a>
      <button type="button" class="yn-iconbtn" aria-label="Close menu" data-yn-nav-close>{% render 'yn-icon', name: 'close' %}</button>
    </div>

    {%- if section.settings.show_promo -%}
      {%- liquid
        assign promo_url = section.settings.promo_link
        if promo_url == blank and promo_product != blank
          assign promo_url = promo_product.url
        endif
        if promo_url == blank
          assign promo_url = collections.all.products.first.url
        endif
        assign promo_title = section.settings.promo_title
        if promo_title == blank and promo_product != blank
          assign promo_title = promo_product.title
        endif
      -%}
      <a class="yn-mnav__promo" href="{{ promo_url | default: routes.all_products_collection_url }}">
        <span class="yn-mnav__ptx">
          {%- if section.settings.promo_rating != blank -%}
            <span class="yn-mnav__rate">{% render 'yn-stars', rating: 5 %}<i>{{ section.settings.promo_rating }}</i></span>
          {%- endif -%}
          <b>{{ promo_title }}</b>
          {%- if section.settings.promo_text != blank -%}<span class="yn-mnav__sub">{{ section.settings.promo_text }}</span>{%- endif -%}
          {%- if section.settings.promo_button != blank -%}<span class="yn-btn yn-btn--solid yn-btn--sm">{{ section.settings.promo_button }}</span>{%- endif -%}
        </span>
        <span class="yn-mnav__pimg">
          {%- if section.settings.promo_image != blank -%}
            {% render 'yn-img', image: section.settings.promo_image, sizes: '160px', widths: '160, 320' %}
          {%- elsif promo_product.featured_image != blank and section.settings.promo_fallback == blank -%}
            {% render 'yn-img', image: promo_product.featured_image, sizes: '160px', widths: '160, 320' %}
          {%- else -%}
            {% render 'yn-img', fallback: section.settings.promo_fallback, alt: '' %}
          {%- endif -%}
        </span>
      </a>
    {%- endif -%}

    <nav class="yn-mnav__list" aria-label="Mobile">
      {%- for link in mobile_menu.links -%}
        <a class="yn-mnav__link" href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}><span>{{ link.title }}</span>{% render 'yn-icon', name: 'chevron-right' %}</a>
        {%- for child in link.links -%}
          <a class="yn-mnav__link yn-mnav__link--child" href="{{ child.url }}"><span>{{ child.title }}</span>{% render 'yn-icon', name: 'chevron-right' %}</a>
        {%- endfor -%}
      {%- endfor -%}
    </nav>

    {%- if section.blocks.size > 0 -%}
      <div class="yn-mnav__trust">
        {%- for block in section.blocks -%}
          <span {{ block.shopify_attributes }}>{% render 'yn-icon', name: block.settings.icon %}{{ block.settings.text | newline_to_br }}</span>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>
<script>window.Shopify = window.Shopify || {}; Shopify.div = Shopify.div || {{ settings.div | json }};</script>

{% schema %}
{
  "name": "YUNA header",
  "class": "yn-header-section",
  "settings": [
    { "type": "header", "content": "Logo" },
    { "type": "image_picker", "id": "logo", "label": "Logo image" },
    { "type": "text", "id": "logo_fallback", "label": "Default logo file (theme asset)", "default": "yn-logo-yuna.png", "info": "Used until a logo image is chosen." },
    { "type": "range", "id": "logo_width", "label": "Logo width, desktop", "min": 60, "max": 240, "step": 2, "unit": "px", "default": 108 },
    { "type": "range", "id": "logo_width_mobile", "label": "Logo width, mobile", "min": 50, "max": 180, "step": 2, "unit": "px", "default": 84 },
    { "type": "header", "content": "Navigation" },
    { "type": "link_list", "id": "menu", "label": "Desktop menu", "default": "main-menu", "info": "Suggested links: Daily Beauty Sleep™ (product), Our Story, Science, Happy Customers." },
    { "type": "select", "id": "layout", "label": "Desktop layout", "options": [
      { "value": "menu-left", "label": "Menu left, logo centre" },
      { "value": "logo-left", "label": "Logo left, menu centre" }
    ], "default": "menu-left" },
    { "type": "checkbox", "id": "show_search", "label": "Show search icon", "default": false },
    { "type": "checkbox", "id": "show_account", "label": "Show account icon", "default": false },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFFFFF", "info": "White matches the page background. With the floating style it turns slightly see-through after scrolling." },
    { "type": "checkbox", "id": "show_line", "label": "Show bottom line", "default": true },
    { "type": "color", "id": "line_color", "label": "Bottom line colour", "default": "#EFEAE3" },
    { "type": "checkbox", "id": "sticky", "label": "Sticky header", "default": true },
    { "type": "checkbox", "id": "floating", "label": "Floating pill style after scrolling", "default": true },
    { "type": "header", "content": "Mobile menu" },
    { "type": "link_list", "id": "mobile_menu", "label": "Mobile menu", "info": "Leave empty to use the desktop menu. Suggested: Home, Our Story, Science, Happy Customers, FAQs, Contact Us." },
    { "type": "checkbox", "id": "show_promo", "label": "Show product card", "default": true },
    { "type": "product", "id": "promo_product", "label": "Product" },
    { "type": "text", "id": "promo_title", "label": "Title", "info": "Defaults to the product title." },
    { "type": "text", "id": "promo_text", "label": "Text", "default": "Save 25% on 3 bottles, with free delivery" },
    { "type": "text", "id": "promo_rating", "label": "Rating label", "default": "4.9", "info": "Leave empty to hide the stars." },
    { "type": "text", "id": "promo_button", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "promo_link", "label": "Link", "info": "Defaults to the product page." },
    { "type": "image_picker", "id": "promo_image", "label": "Image" },
    { "type": "text", "id": "promo_fallback", "label": "Default image file (theme asset)", "default": "yn-menu-jar.webp" }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Mobile menu trust item",
      "limit": 4,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "shield", "label": "Shield" }, { "value": "truck", "label": "Delivery" }, { "value": "flask", "label": "Lab" },
          { "value": "leaf", "label": "Leaf" }, { "value": "moon", "label": "Moon" }, { "value": "heart", "label": "Heart" }, { "value": "sparkle", "label": "Sparkle" }
        ], "default": "shield" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "90-night\nguarantee" }
      ]
    }
  ]
}
{% endschema %}

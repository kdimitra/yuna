<section class="{% render 'yn-section-class', s: section %} yn-rows" id="yn-{{ section.id }}">
  <div class="yn-wrap">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="yn-head yn-head--center yn-head--narrow yn-rv">
        {%- render 'yn-heading', heading: section.settings.heading, accent: section.settings.accent, size: 'm' -%}
        {%- if section.settings.text != blank -%}<p class="yn-head__sub">{{ section.settings.text }}</p>{%- endif -%}
      </div>
    {%- endif -%}
    {%- for block in section.blocks -%}
      {%- liquid
        assign rev = false
        assign m = forloop.index | modulo: 2
        if section.settings.alternate and m == 0
          assign rev = true
        endif
        if section.settings.start_right
          if rev
            assign rev = false
          else
            assign rev = true
          endif
        endif
      -%}
      <div class="yn-row{% if rev %} yn-row--rev{% endif %} yn-rv" {{ block.shopify_attributes }}>
        <div class="yn-row__img">
          {% render 'yn-img', image: block.settings.image, fallback: block.settings.fallback, alt: block.settings.alt, sizes: '(max-width: 900px) 100vw, 524px', widths: '400, 600, 800, 1100' %}
        </div>
        <div class="yn-row__tx">
          {%- if block.settings.number != blank or block.settings.label != blank -%}
            <div class="yn-row__k"><span>{{ block.settings.number }}</span><i aria-hidden="true"></i><small>{{ block.settings.label }}</small></div>
          {%- endif -%}
          {%- if block.settings.title != blank -%}<h3 class="yn-row__t">{{ block.settings.title }}</h3>{%- endif -%}
          <div class="yn-rte">{{ block.settings.text }}</div>
          {%- if block.settings.note != blank -%}<div class="yn-row__note">{{ block.settings.note }}</div>{%- endif -%}
          {%- render 'yn-button', label: block.settings.button_label, link: block.settings.button_link, style: 'outline' -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "YUNA numbered rows",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Great skin starts" },
    { "type": "text", "id": "accent", "label": "Heading accent", "default": "with better rest." },
    { "type": "textarea", "id": "text", "label": "Subheading" },
    { "type": "checkbox", "id": "alternate", "label": "Alternate image side", "default": true },
    { "type": "checkbox", "id": "start_right", "label": "First image on the right", "default": false },
    { "type": "header", "content": "Section style" },
    { "type": "select", "id": "bg", "label": "Background", "options": [{ "value": "white", "label": "White" }, { "value": "cream", "label": "Cream" }, { "value": "beige", "label": "Beige" }, { "value": "navy", "label": "Navy" }], "default": "white" },
    { "type": "select", "id": "pt", "label": "Space above", "options": [{ "value": "none", "label": "None" }, { "value": "half", "label": "Half" }, { "value": "full", "label": "Full" }], "default": "half" },
    { "type": "select", "id": "pb", "label": "Space below", "options": [{ "value": "none", "label": "None" }, { "value": "half", "label": "Half" }, { "value": "full", "label": "Full" }], "default": "half" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (4:3)" },
        { "type": "text", "id": "fallback", "label": "Default image file (theme asset)" },
        { "type": "text", "id": "alt", "label": "Image description" },
        { "type": "text", "id": "number", "label": "Number", "default": "01" },
        { "type": "text", "id": "label", "label": "Label", "default": "Skin that looks tired" },
        { "type": "text", "id": "title", "label": "Title", "default": "Your skincare isn’t the problem." },
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "richtext", "id": "note", "label": "Highlighted note" },
        { "type": "text", "id": "button_label", "label": "Button label" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "presets": [{ "name": "YUNA numbered rows", "blocks": [{ "type": "row" }, { "type": "row" }] }]
}
{% endschema %}

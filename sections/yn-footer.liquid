{%- assign badges_class = 'yn-ftr__badges' -%}{%- if section.settings.badges_light -%}{%- assign badges_class = 'yn-ftr__badges yn-ftr__badges--light' -%}{%- endif -%}
<footer class="yn yn-ftr" style="--ftr-bg:{{ section.settings.bg }}">
  <div class="yn-wrap">
    <div class="yn-ftr__grid">
      <div class="yn-ftr__brand">
        <a class="yn-logo yn-logo--ftr" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}" style="--logo-w:{{ section.settings.logo_width }}px">
          {%- if section.settings.logo != blank -%}
            {{ section.settings.logo | image_url: width: 600 | image_tag: class: 'yn-logo__img', alt: shop.name, sizes: '200px', widths: '200, 400, 600' }}
          {%- elsif section.settings.logo_fallback != blank -%}
            <img class="yn-logo__img" src="{{ section.settings.logo_fallback | asset_url }}" alt="{{ shop.name | escape }}" width="1062" height="278" loading="lazy">
          {%- else -%}<span class="yn-logo__text">{{ shop.name }}</span>{%- endif -%}
        </a>
        {%- if section.settings.mission != blank -%}<div class="yn-ftr__mission">{{ section.settings.mission }}</div>{%- endif -%}
        {%- if section.settings.badges != blank or section.settings.badges_fallback != blank -%}
          {% render 'yn-img', image: section.settings.badges, fallback: section.settings.badges_fallback, alt: section.settings.badges_alt, class: badges_class, sizes: '260px', widths: '260, 520' %}
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            <nav class="yn-ftr__col" aria-label="{{ block.settings.heading | escape }}" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}<h2 class="yn-ftr__h">{{ block.settings.heading }}</h2>{%- endif -%}
              {%- for link in block.settings.menu.links -%}
                <a href="{{ link.url }}">{{ link.title }}</a>
              {%- endfor -%}
            </nav>
          {%- when 'text' -%}
            <div class="yn-ftr__col" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}<h2 class="yn-ftr__h">{{ block.settings.heading }}</h2>{%- endif -%}
              <div class="yn-ftr__txt">{{ block.settings.text }}</div>
            </div>
          {%- when 'social' -%}
            <div class="yn-ftr__col" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}<h2 class="yn-ftr__h">{{ block.settings.heading }}</h2>{%- endif -%}
              {%- liquid
                assign ig = block.settings.instagram | default: settings.social_instagram_link
                assign fb = block.settings.facebook | default: settings.social_facebook_link
                assign tt = block.settings.tiktok | default: settings.social_tiktok_link
                assign yt = block.settings.youtube | default: settings.social_youtube_link
              -%}
              <div class="yn-ftr__social">
                {%- comment -%} Instagram, Facebook and TikTok always show (design). Add the links in the block or in Theme settings > Social media. {%- endcomment -%}
                <a href="{{ ig | default: '#' }}"{% if ig != blank %} target="_blank" rel="noopener"{% endif %} aria-label="Instagram">{% render 'yn-icon', name: 'instagram' %}</a>
                <a href="{{ fb | default: '#' }}"{% if fb != blank %} target="_blank" rel="noopener"{% endif %} aria-label="Facebook">{% render 'yn-icon', name: 'facebook' %}</a>
                <a href="{{ tt | default: '#' }}"{% if tt != blank %} target="_blank" rel="noopener"{% endif %} aria-label="TikTok">{% render 'yn-icon', name: 'tiktok' %}</a>
                {%- if yt != blank -%}<a href="{{ yt }}" target="_blank" rel="noopener" aria-label="YouTube">{% render 'yn-icon', name: 'youtube' %}</a>{%- endif -%}
              </div>
              {%- if block.settings.note != blank -%}<p class="yn-ftr__note">{{ block.settings.note }}</p>{%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="yn-ftr__base">
      <span>{%- if section.settings.copyright != blank -%}{{ section.settings.copyright }}{%- else -%}© {{ 'now' | date: '%Y' }} {{ shop.name }}{%- endif -%}</span>
      {%- if section.settings.show_payment and shop.enabled_payment_types.size > 0 -%}
        <ul class="yn-ftr__pay" aria-label="Payment methods">
          {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'yn-pay-icon' }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "YUNA footer",
  "settings": [
    { "type": "color", "id": "bg", "label": "Background", "default": "#171B2F" },
    { "type": "image_picker", "id": "logo", "label": "Logo (light version)" },
    { "type": "text", "id": "logo_fallback", "label": "Default logo file (theme asset)", "default": "yn-logo-yuna-light.png" },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 60, "max": 260, "step": 2, "unit": "px", "default": 130 },
    { "type": "richtext", "id": "mission", "label": "Mission text", "default": "<p>We’re on a mission to help 1,000,000 women restore beauty sleep and wake up refreshed.</p>" },
    { "type": "image_picker", "id": "badges", "label": "Certification badges image", "info": "For example ISO 9001 / GMP / lab tested / vegan badges." },
    { "type": "text", "id": "badges_fallback", "label": "Default badges file (theme asset)", "default": "yn-certs-navy.png", "info": "Clear to hide the badges." },
    { "type": "checkbox", "id": "badges_light", "label": "Show badges in a light colour", "default": true, "info": "Turns dark badge artwork light so it reads on the dark footer." },
    { "type": "text", "id": "badges_alt", "label": "Badges description", "default": "ISO 9001, GMP certified, third-party lab tested, vegan friendly" },
    { "type": "text", "id": "copyright", "label": "Copyright text", "default": "© 2026 YUNA Sleep. All rights reserved." },
    { "type": "checkbox", "id": "show_payment", "label": "Show payment icons", "default": false }
  ],
  "blocks": [
    { "type": "menu", "name": "Menu", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
      { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
    ] },
    { "type": "text", "name": "Text", "settings": [
      { "type": "text", "id": "heading", "label": "Heading" },
      { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Questions? Email hello@yunasleep.com</p>" }
    ] },
    { "type": "social", "name": "Social icons", "limit": 1, "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Follow us" },
      { "type": "url", "id": "instagram", "label": "Instagram link" },
      { "type": "url", "id": "facebook", "label": "Facebook link" },
      { "type": "url", "id": "tiktok", "label": "TikTok link" },
      { "type": "url", "id": "youtube", "label": "YouTube link" },
      { "type": "paragraph", "content": "Empty links fall back to Theme settings > Social media. Icons without a link are hidden." },
      { "type": "text", "id": "note", "label": "Note" }
    ] }
  ],
  "presets": [{ "name": "YUNA footer", "blocks": [{ "type": "menu" }, { "type": "menu" }, { "type": "social" }] }]
}
{% endschema %}

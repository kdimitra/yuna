{%- if section.blocks.size > 0 -%}
<div class="yn yn-mq yn-bg-{{ section.settings.bg }}" style="--mq-dur:{{ section.settings.speed }}s;--mq-dot:{{ section.settings.dot }}" role="region" aria-label="{{ section.settings.label | escape }}">
  <div class="yn-mq__track" data-yn-marquee>
    {%- for i in (1..2) -%}
      <div class="yn-mq__group"{% if i == 2 %} aria-hidden="true"{% endif %}>
        {%- for block in section.blocks -%}
          <span class="yn-mq__item" {% if i == 1 %}{{ block.shopify_attributes }}{% endif %}>{{ block.settings.text }}</span><i class="yn-mq__dot" aria-hidden="true"></i>
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "YUNA scrolling strip",
  "settings": [
    { "type": "text", "id": "label", "label": "Accessible label", "default": "Our promises" },
    { "type": "select", "id": "bg", "label": "Background", "options": [{ "value": "white", "label": "White" }, { "value": "cream", "label": "Cream" }, { "value": "beige", "label": "Beige" }, { "value": "navy", "label": "Navy" }], "default": "cream" },
    { "type": "color", "id": "dot", "label": "Dot colour", "default": "#9A7B5C" },
    { "type": "range", "id": "speed", "label": "Loop duration (higher is slower)", "min": 10, "max": 90, "step": 2, "unit": "s", "default": 40 }
  ],
  "blocks": [
    { "type": "item", "name": "Item", "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Melatonin-free" }] }
  ],
  "presets": [{ "name": "YUNA scrolling strip", "blocks": [{ "type": "item" }, { "type": "item", "settings": { "text": "Imperial Lingzhi™" } }, { "type": "item", "settings": { "text": "Free delivery" } }] }]
}
{% endschema %}

{{ 'yn-science.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<section class="yn yn-sci yn-sci-j" id="yn-{{ section.id }}"
  style="{% render 'yn-sci-vars', s: s %}--cols:{{ s.columns }};--cols-m:{{ s.columns_m }};--ratio:{{ s.ratio }};--rad:{{ s.radius }}px;--j-n:{{ s.number_color }};--j-line:{{ s.line_color }}">
  <div class="yn-wrap">
    {%- if s.heading != blank or s.accent != blank or s.text != blank -%}
      <div class="yn-sci__head yn-rv">
        {%- if s.heading != blank or s.accent != blank -%}
          <h2 class="yn-sci__h">{{ s.heading }}{% if s.accent != blank %} <em>{{ s.accent }}</em>{% endif %}</h2>
        {%- endif -%}
        {%- if s.text != blank -%}<div class="yn-sci__sub">{{ s.text }}</div>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="yn-sci-j__grid">
      {%- for block in section.blocks -%}
        <div class="yn-sci-j__step yn-rv" {{ block.shopify_attributes }}>
          <div class="yn-sci-j__ph">{% render 'yn-img', image: block.settings.image, fallback: block.settings.fallback, alt: block.settings.alt, sizes: '(max-width: 900px) 100vw, 33vw', widths: '400, 600, 800, 1000' %}</div>
          {%- if block.settings.number != blank -%}<span class="yn-sci-j__n">{{ block.settings.number }}</span>{%- endif -%}
          {%- if block.settings.title != blank -%}<h3>{{ block.settings.title }}</h3>{%- endif -%}
          {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Science · Journey steps",
  "class": "yn-sci-section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From nature," },
    { "type": "text", "id": "accent", "label": "Heading accent (second part)", "default": "to lab, to your night." },
    { "type": "richtext", "id": "text", "label": "Subheading" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "columns", "label": "Columns, desktop", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "select", "id": "columns_m", "label": "Columns, mobile", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }], "default": "1" },
    { "type": "select", "id": "ratio", "label": "Image shape", "options": [{ "value": "4/3", "label": "Landscape 4:3" }, { "value": "1/1", "label": "Square" }, { "value": "4/5", "label": "Portrait 4:5" }, { "value": "16/9", "label": "Wide 16:9" }], "default": "4/3" },
    { "type": "range", "id": "radius", "label": "Image corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 20 },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "Heading and step titles", "default": "#161B30" },
    { "type": "color", "id": "accent_color", "label": "Heading accent", "default": "#161B30" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#575B6A" },
    { "type": "color", "id": "number_color", "label": "Step number", "default": "#575B6A" },
    { "type": "color", "id": "line_color", "label": "Line under the number", "default": "#C9B89A" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pt", "label": "Space above, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "pb", "label": "Space below, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "pt_m", "label": "Space above, mobile", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 22 },
    { "type": "range", "id": "pb_m", "label": "Space below, mobile", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 22 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback", "label": "Default image file (theme asset)" },
        { "type": "text", "id": "alt", "label": "Image description" },
        { "type": "text", "id": "number", "label": "Number", "default": "01" },
        { "type": "text", "id": "title", "label": "Title", "default": "Grown where it thrives" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{
    "name": "Science · Journey steps",
    "blocks": [
      { "type": "step", "settings": { "fallback": "yn-lingzhi-mountain.webp", "number": "01", "title": "Grown where it thrives" } },
      { "type": "step", "settings": { "fallback": "yn-lab-lingzhi.webp", "number": "02", "title": "Checked in the lab" } },
      { "type": "step", "settings": { "fallback": "yn-life-unwind.webp", "number": "03", "title": "Part of your evening" } }
    ]
  }]
}
{% endschema %}

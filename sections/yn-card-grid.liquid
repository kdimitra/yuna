<section class="{% render 'yn-section-class', s: section %} yn-cards yn-cards--{{ section.settings.style }}" id="yn-{{ section.id }}" style="--cols:{{ section.settings.columns }};--cols-m:{{ section.settings.columns_m }};--card-ratio:{{ section.settings.ratio }}">
  <div class="yn-wrap">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="yn-head yn-head--center yn-head--narrow yn-rv">
        {%- render 'yn-heading', heading: section.settings.heading, accent: section.settings.accent, size: 'm' -%}
        {%- if section.settings.text != blank -%}<p class="yn-head__sub">{{ section.settings.text }}</p>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="yn-cards__grid">
      {%- for block in section.blocks -%}
        <article class="yn-card yn-rv" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank or block.settings.fallback != blank -%}
            <div class="yn-card__ph">
              {% render 'yn-img', image: block.settings.image, fallback: block.settings.fallback, alt: block.settings.alt, sizes: '(max-width: 900px) 100vw, 33vw', widths: '300, 450, 600, 800' %}
              {%- if block.settings.badge != blank -%}<span class="yn-card__badge">{{ block.settings.badge }}</span>{%- endif -%}
            </div>
          {%- endif -%}
          <div class="yn-card__bd">
            {%- if block.settings.number != blank -%}<span class="yn-card__n">{{ block.settings.number }}</span>{%- endif -%}
            {%- if block.settings.eyebrow != blank -%}<span class="yn-card__eb">{{ block.settings.eyebrow }}</span>{%- endif -%}
            {%- if block.settings.title != blank -%}<h3 class="yn-card__t">{{ block.settings.title }}</h3>{%- endif -%}
            {%- if block.settings.location != blank -%}<p class="yn-card__loc">{% render 'yn-icon', name: 'pin' %}{{ block.settings.location }}</p>{%- endif -%}
            {%- if block.settings.text != blank -%}<p class="yn-card__tx">{{ block.settings.text }}</p>{%- endif -%}
            {%- if block.settings.pill != blank -%}<span class="yn-pill">{{ block.settings.pill }}</span>{%- endif -%}
            {%- if block.settings.link_label != blank -%}<a class="yn-card__link" href="{{ block.settings.link }}">{{ block.settings.link_label }}{% render 'yn-icon', name: 'arrow-right' %}</a>{%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
    {%- if section.settings.button_label != blank -%}
      <p class="yn-center yn-mt-l">{% render 'yn-button', label: section.settings.button_label, link: section.settings.button_link %}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "YUNA card grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the mountains" },
    { "type": "text", "id": "accent", "label": "Heading accent", "default": "to your nightly ritual." },
    { "type": "textarea", "id": "text", "label": "Subheading" },
    { "type": "select", "id": "style", "label": "Card style", "options": [
      { "value": "card", "label": "Card (photo + caption box)" },
      { "value": "open", "label": "Open (photo, number, text)" },
      { "value": "badge", "label": "Badge (small centred icon)" },
      { "value": "detail", "label": "Detailed (dose badge, location, pill)" }
    ], "default": "card" },
    { "type": "range", "id": "columns", "label": "Columns, desktop", "min": 2, "max": 4, "step": 1, "default": 4 },
    { "type": "select", "id": "columns_m", "label": "Columns, mobile", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }], "default": "2" },
    { "type": "select", "id": "ratio", "label": "Image shape", "options": [{ "value": "1/1", "label": "Square" }, { "value": "4/3", "label": "Landscape 4:3" }, { "value": "4/5", "label": "Portrait 4:5" }], "default": "1/1" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Section style" },
    { "type": "select", "id": "bg", "label": "Background", "options": [{ "value": "white", "label": "White" }, { "value": "cream", "label": "Cream" }, { "value": "beige", "label": "Beige" }, { "value": "navy", "label": "Navy" }], "default": "white" },
    { "type": "select", "id": "pt", "label": "Space above", "options": [{ "value": "none", "label": "None" }, { "value": "half", "label": "Half" }, { "value": "full", "label": "Full" }], "default": "half" },
    { "type": "select", "id": "pb", "label": "Space below", "options": [{ "value": "none", "label": "None" }, { "value": "half", "label": "Half" }, { "value": "full", "label": "Full" }], "default": "half" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback", "label": "Default image file (theme asset)" },
        { "type": "text", "id": "alt", "label": "Image description" },
        { "type": "text", "id": "badge", "label": "Badge on image", "info": "E.g. 400 mg" },
        { "type": "text", "id": "number", "label": "Number", "info": "E.g. 01" },
        { "type": "text", "id": "eyebrow", "label": "Small label above title" },
        { "type": "text", "id": "title", "label": "Title", "default": "Imperial Lingzhi™" },
        { "type": "text", "id": "location", "label": "Location line" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "text", "id": "pill", "label": "Pill" },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "YUNA card grid", "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }, { "type": "card" }] }]
}
{% endschema %}

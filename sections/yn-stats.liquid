<section class="{% render 'yn-section-class', s: section %} yn-stats" id="yn-{{ section.id }}" style="--ring:{{ section.settings.ring_color }};--ring-track:{{ section.settings.track_color }};--ring-w:{{ section.settings.ring_width }};--ring-num:{{ section.settings.number_color }}">
  <div class="yn-wrap">
    <div class="yn-stats__head yn-rv">
      <div>
        {%- if section.settings.show_award -%}
          <div class="yn-award yn-award--inline yn-show-m">
            <img src="{{ 'yn-laurel-l.png' | asset_url }}" alt="" width="22" height="53" loading="lazy">
            <span>{{ section.settings.award_l1 }}<br>{{ section.settings.award_l2 }}</span>
            <img src="{{ 'yn-laurel-r.png' | asset_url }}" alt="" width="22" height="53" loading="lazy">
          </div>
        {%- endif -%}
        {%- render 'yn-heading', heading: section.settings.heading, accent: section.settings.accent, size: 'm' -%}
      </div>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="yn-stats__grid">
      {%- for block in section.blocks -%}
        <div class="yn-stat yn-rv" {{ block.shopify_attributes }}>
          <div class="yn-stat__ring" style="--p:{{ block.settings.value | at_most: 100 }}" data-yn-ring>
            <svg viewBox="0 0 120 120" aria-hidden="true"><circle class="bg" cx="60" cy="60" r="52"/><circle class="fg" cx="60" cy="60" r="52" pathLength="100"/></svg>
            <b data-yn-count="{{ block.settings.value }}"><span>{{ block.settings.value }}</span><sup>{{ block.settings.suffix }}</sup></b>
          </div>
          <strong>{{ block.settings.title }}</strong>
          {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.note != blank or section.settings.button_label != blank -%}
      <div class="yn-stats__foot">
        {%- if section.settings.note != blank -%}<p>{{ section.settings.note }}</p>{%- endif -%}
        {%- render 'yn-button', label: section.settings.button_label, link: section.settings.button_link -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "YUNA stats rings",
  "settings": [
    { "type": "checkbox", "id": "show_award", "label": "Show award badge (mobile)", "default": true },
    { "type": "text", "id": "award_l1", "label": "Award line 1", "default": "Award-winning" },
    { "type": "text", "id": "award_l2", "label": "Award line 2", "default": "Formulation" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Feel the beauty sleep difference," },
    { "type": "text", "id": "accent", "label": "Heading accent", "default": "naturally." },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "note", "label": "Footnote", "default": "*Self-reported results from YUNA customers. Individual results may vary." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Daily Beauty Sleep™" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Rings" },
    { "type": "color", "id": "ring_color", "label": "Filled ring", "default": "#3A5BA0" },
    { "type": "color", "id": "track_color", "label": "Empty ring track", "default": "#EAE9E9" },
    { "type": "range", "id": "ring_width", "label": "Ring thickness", "min": 2, "max": 12, "step": 1, "default": 7 },
    { "type": "color", "id": "number_color", "label": "Number", "default": "#161B30" },
    { "type": "header", "content": "Section style" },
    { "type": "select", "id": "bg", "label": "Background", "options": [{ "value": "white", "label": "White" }, { "value": "cream", "label": "Cream" }, { "value": "beige", "label": "Beige" }, { "value": "navy", "label": "Navy" }], "default": "cream" },
    { "type": "select", "id": "pt", "label": "Space above", "options": [{ "value": "none", "label": "None" }, { "value": "half", "label": "Half" }, { "value": "full", "label": "Full" }], "default": "half" },
    { "type": "select", "id": "pb", "label": "Space below", "options": [{ "value": "none", "label": "None" }, { "value": "half", "label": "Half" }, { "value": "full", "label": "Full" }], "default": "half" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 6,
      "settings": [
        { "type": "range", "id": "value", "label": "Number", "min": 0, "max": 100, "step": 1, "default": 15 },
        { "type": "text", "id": "suffix", "label": "Suffix", "default": "%" },
        { "type": "text", "id": "title", "label": "Title", "default": "Fall asleep faster" },
        { "type": "text", "id": "text", "label": "Text", "default": "Ease into sleep naturally and blissfully." }
      ]
    }
  ],
  "presets": [{ "name": "YUNA stats rings", "blocks": [{ "type": "stat" }, { "type": "stat" }, { "type": "stat" }, { "type": "stat" }] }]
}
{% endschema %}
